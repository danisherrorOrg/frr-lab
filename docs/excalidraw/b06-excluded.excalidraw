  {
   "id": "b06-text-10",
   "type": "text",
   "x": 638,
   "y": 128,
   "width": 715,
   "height": 28,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
