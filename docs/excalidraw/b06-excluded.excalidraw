   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b06-text-43",
   "type": "text",
   "x": 571,
   "y": 820,
   "width": 496,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 340517,
   "version": 1,
   "versionNonce": 4503347,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The operator drains S–N to work on it, a link fails,\nand the LFA puts traffic straight onto S–N anyway.\nThe repair lands on the one link that was meant to\nbe empty.",
   "originalText": "The operator drains S–N to work on it, a link fails,\nand the LFA puts traffic straight onto S–N anyway.\nThe repair lands on the one link that was meant to\nbe empty.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b06-text-44",
   "type": "text",
   "x": 571,
   "y": 915,
   "width": 475,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 348436,
   "version": 1,
   "versionNonce": 4608076,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A metric of 16,777,214 is just a very high cost: N is\nthen checked like any other neighbor.",
   "originalText": "A metric of 16,777,214 is just a very high cost: N is\nthen checked like any other neighbor.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
