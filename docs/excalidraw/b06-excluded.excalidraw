   "seed": 395950,
   "version": 1,
   "versionNonce": 5236450,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A link with the maximum metric 16,777,215, in either direction, means \"keep traffic off\". So the neighbor behind it is never used as an LFA, even when it passes every\ninequality. The same skip happens for an overloaded neighbor, one the LFA policy excludes, and one on the same LAN.",
   "originalText": "A link with the maximum metric 16,777,215, in either direction, means \"keep traffic off\". So the neighbor behind it is never used as an LFA, even when it passes every\ninequality. The same skip happens for an overloaded neighbor, one the LFA policy excludes, and one on the same LAN.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
