   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The square, but the operator has set link S–N to the maximum\nmetric (both ways): \"don’t send traffic here\".",
   "originalText": "The square, but the operator has set link S–N to the maximum\nmetric (both ways): \"don’t send traffic here\".",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
