  {
   "id": "b06-text-39",
   "type": "text",
   "x": 18,
   "y": 820,
   "width": 486,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 308841,
   "version": 1,
   "versionNonce": 4084431,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "computeLfa() skips a link out of S before any check\nfor four reasons, each shown in Explain:",
   "originalText": "computeLfa() skips a link out of S before any check\nfor four reasons, each shown in Explain:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b06-text-40",
   "type": "text",
   "x": 18,
   "y": 873,
   "width": 311,
   "height": 123,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 316760,
   "version": 1,
   "versionNonce": 4189160,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "max-metric  this rule (RFC 5286 §3.5)\noverload    N has the overload bit\n            (§3.5, A17)\nexcluded    lfa_exclude: [N] on S\n            (RFC 7916 §6.2.4.4, A16)\nsame-lan    S–N is on the same LAN as\n            S–E (§3.6, A21)",
   "originalText": "max-metric  this rule (RFC 5286 §3.5)\noverload    N has the overload bit\n            (§3.5, A17)\nexcluded    lfa_exclude: [N] on S\n            (RFC 7916 §6.2.4.4, A16)\nsame-lan    S–N is on the same LAN as\n            S–E (§3.6, A21)",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
