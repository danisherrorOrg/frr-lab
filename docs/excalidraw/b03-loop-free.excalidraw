   "versionNonce": 5131721,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B1  same idea, path forced over\n    the link S→E instead of router S\nB4  downstream: dist(N,D) < dist(S,D)\n    implies loop-free\nB5  node-protecting: avoids router E\nB7  only loop-free ones are ranked\nB9  extended P-space: the same test\n    for every router Y, not only D",
   "originalText": "B1  same idea, path forced over\n    the link S→E instead of router S\nB4  downstream: dist(N,D) < dist(S,D)\n    implies loop-free\nB5  node-protecting: avoids router E\nB7  only loop-free ones are ranked\nB9  extended P-space: the same test\n    for every router Y, not only D",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
