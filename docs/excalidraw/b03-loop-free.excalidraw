   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 2: the ring, link S–E fails, every\nmetric 1",
   "originalText": "Example 2: the ring, link S–E fails, every\nmetric 1",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b03-text-5",
   "type": "text",
   "x": 18,
   "y": 603,
   "width": 556,
   "height": 20,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 39595,
   "version": 1,
   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red dashed: the failed link S–E. S’s only other neighbor is A.",
   "originalText": "Red dashed: the failed link S–E. S’s only other neighbor is A.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b03-text-6",
   "type": "text",
   "x": 18,
   "y": 633,
   "width": 529,
   "height": 40,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red arrows: A’s own shortest path to E is A → S → E (2). It\ngoes back through S: no LFA for E.",
   "originalText": "Red arrows: A’s own shortest path to E is A → S → E (2). It\ngoes back through S: no LFA for E.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b03-text-7",
   "type": "text",
   "x": 18,
   "y": 683,
   "width": 511,
   "height": 40,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green arrows: A’s shortest path to C is A → B → C (2). It\navoids S: A is an LFA for C.",
   "originalText": "Green arrows: A’s shortest path to C is A → B → C (2). It\navoids S: A is an LFA for C.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
