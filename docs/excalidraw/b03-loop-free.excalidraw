  },
  {
   "id": "b03-text-44",
   "type": "text",
   "x": 18,
   "y": 817,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 348436,
   "version": 1,
   "versionNonce": 4608076,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ring, D = E. If S used A anyway, A looks up E in its\nnormal table: next hop S. S sends to A, A sends to\nS, …",
   "originalText": "Ring, D = E. If S used A anyway, A looks up E in its\nnormal table: next hop S. S sends to A, A sends to\nS, …",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b03-text-45",
   "type": "text",
   "x": 18,
   "y": 891,
   "width": 360,
   "height": 19,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 356355,
   "version": 1,
   "versionNonce": 4712805,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S → A → S → A → …   (until TTL runs out)",
   "originalText": "S → A → S → A → …   (until TTL runs out)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b03-text-46",
   "type": "text",
   "x": 18,
   "y": 920,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The traffic never arrives, and it eats the S–A link\nwhile it bounces. So a candidate that fails this\ncheck is never used, whatever the policy says (A16).",
   "originalText": "The traffic never arrives, and it eats the S–A link\nwhile it bounces. So a candidate that fails this\ncheck is never used, whatever the policy says (A16).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
