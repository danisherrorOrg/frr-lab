  {
   "id": "b03-text-55",
   "type": "text",
   "x": 18,
   "y": 1081,
   "width": 1571,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A neighbor is a safe backup only if its own shortest path to D is strictly cheaper than any path back through S: dist(N,D) < dist(N,S) + dist(S,D). A tie fails. In a\nring the neighbor on the far side passes for destinations near it (C) and fails for those near S (E).",
   "originalText": "A neighbor is a safe backup only if its own shortest path to D is strictly cheaper than any path back through S: dist(N,D) < dist(N,S) + dist(S,D). A tie fails. In a\nring the neighbor on the far side passes for destinations near it (C) and fails for those near S (E).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
