  {
   "id": "b19-text-93",
   "type": "text",
   "x": 18,
   "y": 1202,
   "width": 1581,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 736467,
   "version": 1,
   "versionNonce": 9739797,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Node mode plans for the whole next-hop router failing: remove router E, then run the same walk with the check dist(X,Y) < dist(X,E) + dist(E,Y). In Example 8 the link\nrepair 16004, 16006 goes through E; the node repair 16005, 16006 goes around it, at cost 11 instead of 8.",
   "originalText": "Node mode plans for the whole next-hop router failing: remove router E, then run the same walk with the check dist(X,Y) < dist(X,E) + dist(E,Y). In Example 8 the link\nrepair 16004, 16006 goes through E; the node repair 16005, 16006 goes around it, at cost 11 instead of 8.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b19-text-94",
   "type": "text",
   "x": 0,
   "y": 1277,
   "width": 1506,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
