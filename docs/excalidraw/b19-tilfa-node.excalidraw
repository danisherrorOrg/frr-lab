  {
   "id": "b19-text-87",
   "type": "text",
   "x": 571,
   "y": 980,
   "width": 496,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 688953,
   "version": 1,
   "versionNonce": 9111423,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 8, every router as source: 33 pairs, 19 with\nD ≠ E. Against E failing, TI-LFA protects all 19 and\nRemote LFA 16. From S alone: 3 pairs (B, C, D via\nE), 3 and 3.",
   "originalText": "Example 8, every router as source: 33 pairs, 19 with\nD ≠ E. Against E failing, TI-LFA protects all 19 and\nRemote LFA 16. From S alone: 3 pairs (B, C, D via\nE), 3 and 3.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
