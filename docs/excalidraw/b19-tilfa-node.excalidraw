   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Sources: docs/02-algorithms.md §4.4, §5, §16  ·  docs/learn/07-ti-lfa.md (Node protection)  ·  DECISIONS.md D51  ·  examples/08-node-protection.yaml, 10-lan-levels.yaml",
