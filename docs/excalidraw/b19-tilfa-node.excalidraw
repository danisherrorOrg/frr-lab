   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Coverage (A8)",
   "originalText": "Coverage (A8)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
