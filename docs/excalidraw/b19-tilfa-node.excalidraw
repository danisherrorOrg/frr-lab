   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "b19-text-83",
   "type": "text",
   "x": 18,
   "y": 942,
   "width": 198,
   "height": 28,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 657277,
   "version": 1,
   "versionNonce": 8692507,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It can cost more",
   "originalText": "It can cost more",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b19-text-84",
   "type": "text",
   "x": 18,
   "y": 980,
   "width": 496,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 665196,
   "version": 1,
   "versionNonce": 8797236,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Node mode also avoids E, so the repair can cost more\nthan S’s final path after a link failure: 11 instead\nof 8 here. In node mode \"TI-LFA is always the same\nas the final path\" no longer holds (§8, §10).",
   "originalText": "Node mode also avoids E, so the repair can cost more\nthan S’s final path after a link failure: 11 instead\nof 8 here. In node mode \"TI-LFA is always the same\nas the final path\" no longer holds (§8, §10).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
