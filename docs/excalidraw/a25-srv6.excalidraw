   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S pushes 2 SIDs: fits MSD 2. B’s links in Adj-SID\norder are to A (0x40), then to C (0x41).",
   "originalText": "S pushes 2 SIDs: fits MSD 2. B’s links in Adj-SID\norder are to A (0x40), then to C (0x41).",
