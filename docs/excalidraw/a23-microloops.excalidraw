   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The §22 table lists only the first loop; the engine\nfinds both.",
   "originalText": "The §22 table lists only the first loop; the engine\nfinds both.",
