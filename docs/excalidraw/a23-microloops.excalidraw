   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A loop away from the PLR",
   "originalText": "A loop away from the PLR",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
