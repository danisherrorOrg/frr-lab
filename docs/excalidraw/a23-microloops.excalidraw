  },
  {
   "id": "a23-text-46",
   "type": "text",
   "x": 571,
   "y": 850,
   "width": 477,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S–E 1, E–D 1, S–A 1, A–D 5. E–D fails, so E is the\nPLR. To D:",
   "originalText": "S–E 1, E–D 1, S–A 1, A–D 5. E–D fails, so E is the\nPLR. To D:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
