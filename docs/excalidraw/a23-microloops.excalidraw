   "x": 571,
   "y": 903,
   "width": 303,
   "height": 70,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 372193,
   "version": 1,
   "versionNonce": 4922263,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A → S → A  S updated, A waiting\n           (A old: A-S-E-D 3 < 5)\n           no PLR in it: not avoided\nE → S → E  E updated early: avoided",
   "originalText": "A → S → A  S updated, A waiting\n           (A old: A-S-E-D 3 < 5)\n           no PLR in it: not avoided\nE → S → E  E updated early: avoided",
