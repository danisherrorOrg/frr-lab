  {
   "id": "a23-text-42",
   "type": "text",
   "x": 18,
   "y": 850,
   "width": 477,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 332598,
   "version": 1,
   "versionNonce": 4398618,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "RFC 8333: after a link goes down, the PLR stays on\nits FRR repair for a while, so the others update\nfirst. That avoids every loop that needs a PLR to\nupdate early (plrEarly).",
   "originalText": "RFC 8333: after a link goes down, the PLR stays on\nits FRR repair for a while, so the others update\nfirst. That avoids every loop that needs a PLR to\nupdate early (plrEarly).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a23-text-43",
   "type": "text",
   "x": 18,
   "y": 945,
   "width": 378,
   "height": 53,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 340517,
   "version": 1,
   "versionNonce": 4503347,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ex. 2, S–E   to E: A → S → A   PLR S  avoided\n             to S: C → E → C   PLR E  avoided\nEx. 1, S–E   to S: D → E → D   PLR E  avoided",
   "originalText": "Ex. 2, S–E   to E: A → S → A   PLR S  avoided\n             to S: C → E → C   PLR E  avoided\nEx. 1, S–E   to S: D → E → D   PLR E  avoided",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
