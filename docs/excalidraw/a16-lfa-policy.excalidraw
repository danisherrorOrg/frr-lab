   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "When S has more than one LFA, which one it picks is a policy. The knobs change the order (prefer / ignore), rule candidates out (require) or skip a neighbor (exclude).\nThe LFA picked is always loop-free; if the policy leaves none, Remote LFA takes over.",
   "originalText": "When S has more than one LFA, which one it picks is a policy. The knobs change the order (prefer / ignore), rule candidates out (require) or skip a neighbor (exclude).\nThe LFA picked is always loop-free; if the policy leaves none, Remote LFA takes over.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
