  {
   "id": "a16-text-43",
   "type": "text",
   "x": 18,
   "y": 762,
   "width": 444,
   "height": 28,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 340517,
   "version": 1,
   "versionNonce": 4503347,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Best LFA for S → D under each policy",
   "originalText": "Best LFA for S → D under each policy",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a16-text-44",
   "type": "text",
   "x": 18,
   "y": 800,
   "width": 819,
   "height": 207,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 348436,
   "version": 1,
   "versionNonce": 4608076,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Policy                                   Best LFA  Why\n---------------------------------------  --------  ----------------------------------------\ndefault (both prefer)                    B         node-protecting comes first\nnode_protecting: ignore                  A         downstream is next\nboth ignore                              A         lowest cost: 12 < 13\ndownstream: require                      A         B ruled out: not downstream\nnode_protecting: require                 B         A ruled out: not node-protecting\nboth require                             none      → Remote LFA via PQ node A\nS lfa_exclude: [B]                       A         B skipped\nS lfa_exclude: [A, B]                    none      → Remote LFA\nnode_protecting: require, S → E (D = E)  A         node protection can’t apply to E itself",
   "originalText": "Policy                                   Best LFA  Why\n---------------------------------------  --------  ----------------------------------------\ndefault (both prefer)                    B         node-protecting comes first\nnode_protecting: ignore                  A         downstream is next\nboth ignore                              A         lowest cost: 12 < 13\ndownstream: require                      A         B ruled out: not downstream\nnode_protecting: require                 B         A ruled out: not node-protecting\nboth require                             none      → Remote LFA via PQ node A\nS lfa_exclude: [B]                       A         B skipped\nS lfa_exclude: [A, B]                    none      → Remote LFA\nnode_protecting: require, S → E (D = E)  A         node protection can’t apply to E itself",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a16-rectangle-45",
