   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What the policy doesn’t change",
   "originalText": "What the policy doesn’t change",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a16-text-47",
   "type": "text",
   "x": 938,
   "y": 800,
   "width": 676,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 372193,
   "version": 1,
   "versionNonce": 4922263,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  ECMP (B2): another primary next hop is normal forwarding, not an\n   alternate. An excluded neighbor still counts as ECMP.\n•  Remote LFA and TI-LFA: the tunnel exit and the post-convergence path\n   ignore the policy. Remote LFA is only used more often.\n•  SRLG, link colour and bandwidth criteria of RFC 7916 aren’t\n   modelled.",
   "originalText": "•  ECMP (B2): another primary next hop is normal forwarding, not an\n   alternate. An excluded neighbor still counts as ECMP.\n•  Remote LFA and TI-LFA: the tunnel exit and the post-convergence path\n   ignore the policy. Remote LFA is only used more often.\n•  SRLG, link colour and bandwidth criteria of RFC 7916 aren’t\n   modelled.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
