   "link": null,
   "locked": false
  },
  {
   "id": "a16-text-46",
   "type": "text",
   "x": 938,
   "y": 762,
   "width": 370,
   "height": 28,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
