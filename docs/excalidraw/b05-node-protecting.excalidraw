   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "lfa_policy:\n  node_protecting: prefer | require | ignore",
   "originalText": "lfa_policy:\n  node_protecting: prefer | require | ignore",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b05-text-51",
   "type": "text",
   "x": 571,
   "y": 848,
   "width": 448,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 403869,
   "version": 1,
   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  prefer (default): step 1 of B7.\n•  require: link-only LFAs are never chosen\n   (not-node-protecting).\n•  ignore: step 1 is skipped. In §15, A is then\n   picked.",
   "originalText": "•  prefer (default): step 1 of B7.\n•  require: link-only LFAs are never chosen\n   (not-node-protecting).\n•  ignore: step 1 is skipped. In §15, A is then\n   picked.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
