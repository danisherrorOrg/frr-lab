  },
  {
   "id": "b05-text-46",
   "type": "text",
   "x": 18,
   "y": 800,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Step 1, before downstream and before cost. In §15, B\nwins over A although A is downstream and cheaper (12\nvs 13).",
   "originalText": "Step 1, before downstream and before cost. In §15, B\nwins over A although A is downstream and cheaper (12\nvs 13).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b05-text-47",
   "type": "text",
   "x": 18,
   "y": 874,
   "width": 475,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 372193,
   "version": 1,
   "versionNonce": 4922263,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 6, N → D (primary via E): M (cost 20,\nnode-protecting) beats S (cost 3, link-only). That is\nwhy N saves the traffic when E fails.",
   "originalText": "Example 6, N → D (primary via E): M (cost 20,\nnode-protecting) beats S (cost 3, link-only). That is\nwhy N saves the traffic when E fails.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b05-rectangle-48",
   "type": "rectangle",
   "x": 553,
   "y": 744,
   "width": 533,
