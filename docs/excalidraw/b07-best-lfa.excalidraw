   "roundness": null,
   "seed": 300922,
   "version": 1,
   "versionNonce": 3979702,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "LFA policy changes steps 1 and 2 (A16)",
   "originalText": "LFA policy changes steps 1 and 2 (A16)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-text-39",
   "type": "text",
   "x": 571,
   "y": 896,
   "width": 311,
   "height": 140,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 308841,
   "version": 1,
   "versionNonce": 4084431,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "§15 example, S → D        Best\n-----------------------   -----------\ndefault                   B\nnode_protecting: ignore   A  (step 2)\nboth ignore               A  (step 3)\ndownstream: require       A\nnode_protecting: require  B\nboth require              none → RLFA",
   "originalText": "§15 example, S → D        Best\n-----------------------   -----------\ndefault                   B\nnode_protecting: ignore   A  (step 2)\nboth ignore               A  (step 3)\ndownstream: require       A\nnode_protecting: require  B\nboth require              none → RLFA",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
