   "version": 1,
   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Compare two candidates step by step. The first step where they\ndiffer decides; later steps only break ties.",
   "originalText": "Compare two candidates step by step. The first step where they\ndiffer decides; later steps only break ties.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-text-6",
   "type": "text",
   "x": 18,
   "y": 742,
   "width": 529,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
