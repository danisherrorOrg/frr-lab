   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 348436,
   "version": 1,
   "versionNonce": 4608076,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-text-45",
   "type": "text",
   "x": 18,
   "y": 1130,
   "width": 1581,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 356355,
   "version": 1,
   "versionNonce": 4712805,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "When several neighbors are loop-free, pick the safest first: one that survives router E failing, then one that is closer to D. Only then the cheapest, and finally the\nlowest id, so the answer is always the same. A cheaper backup can lose to a safer one (§15: B at 13 beats A at 12).",
   "originalText": "When several neighbors are loop-free, pick the safest first: one that survives router E failing, then one that is closer to D. Only then the cheapest, and finally the\nlowest id, so the answer is always the same. A cheaper backup can lose to a safer one (§15: B at 13 beats A at 12).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-text-46",
   "type": "text",
   "x": 0,
   "y": 1205,
   "width": 1613,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
