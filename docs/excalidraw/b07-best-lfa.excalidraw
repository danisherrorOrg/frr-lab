   "text": "The order: first difference wins",
   "originalText": "The order: first difference wins",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-text-5",
   "type": "text",
   "x": 18,
   "y": 692,
   "width": 556,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
