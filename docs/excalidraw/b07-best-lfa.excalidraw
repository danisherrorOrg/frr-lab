   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Safety first (survives router E, no microloops), then cost,\nthen a fixed id order so every run gives the same answer\n(project rule 1).",
   "originalText": "Safety first (survives router E, no microloops), then cost,\nthen a fixed id order so every run gives the same answer\n(project rule 1).",
