   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Edge cases",
   "originalText": "Edge cases",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-text-42",
   "type": "text",
   "x": 1125,
   "y": 896,
   "width": 477,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 332598,
   "version": 1,
   "versionNonce": 4398618,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  SRLG mode (A19): \"SRLG-disjoint first\" goes in\n   front of step 1 (RFC 7916 §6.2.4.1).\n•  Only loop-free candidates are ranked: a cheaper\n   one that fails B3 is never picked.\n•  Router id order is plain text order of the ids\n   (\"L2\" < \"L3\").",
   "originalText": "•  SRLG mode (A19): \"SRLG-disjoint first\" goes in\n   front of step 1 (RFC 7916 §6.2.4.1).\n•  Only loop-free candidates are ranked: a cheaper\n   one that fails B3 is never picked.\n•  Router id order is plain text order of the ids\n   (\"L2\" < \"L3\").",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-rectangle-43",
