   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why this order",
   "originalText": "Why this order",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-text-36",
   "type": "text",
   "x": 18,
   "y": 896,
   "width": 486,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 285084,
   "version": 1,
   "versionNonce": 3770244,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "RFC 5286 §1: a router SHOULD pick a node-protecting\nLFA over a link-only one. §3.6 adds downstream.\nAfter that the RFC leaves it to \"distance, IP\naddresses, or any router-local tie-breaker\", so\nlowest cost then lowest id is our choice (D7, D16).",
   "originalText": "RFC 5286 §1: a router SHOULD pick a node-protecting\nLFA over a link-only one. §3.6 adds downstream.\nAfter that the RFC leaves it to \"distance, IP\naddresses, or any router-local tie-breaker\", so\nlowest cost then lowest id is our choice (D7, D16).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b07-rectangle-37",
   "type": "rectangle",
   "x": 553,
   "y": 840,
   "width": 533,
   "height": 214,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "#fff4e6",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 293003,
   "version": 1,
   "versionNonce": 3874973,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "b07-text-38",
   "type": "text",
   "x": 571,
   "y": 858,
   "width": 469,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
