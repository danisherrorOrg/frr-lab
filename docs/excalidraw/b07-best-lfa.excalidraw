   "locked": false
  },
  {
   "id": "b07-text-44",
   "type": "text",
   "x": 18,
   "y": 1092,
   "width": 99,
   "height": 28,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
