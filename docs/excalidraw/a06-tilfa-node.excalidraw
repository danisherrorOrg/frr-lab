   "versionNonce": 1256748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Remove node E and all its links, run SPF from S: S → N → B → C → D, cost 11. (Link mode would give S →\nN → B → E → D, cost 8, which goes through E.)",
   "originalText": "Remove node E and all its links, run SPF from S: S → N → B → C → D, cost 11. (Link mode would give S →\nN → B → E → D, cost 8, which goes through E.)",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
