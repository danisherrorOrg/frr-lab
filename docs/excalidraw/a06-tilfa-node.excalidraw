   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "[PrefixSID(C), PrefixSID(D)] = 16005, 16006    out via N    extra labels = 1    protects = node",
   "originalText": "[PrefixSID(C), PrefixSID(D)] = 16005, 16006    out via N    extra labels = 1    protects = node",
