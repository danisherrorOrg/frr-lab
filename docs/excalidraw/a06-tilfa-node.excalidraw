  },
  {
   "id": "a06-text-69",
   "type": "text",
   "x": 18,
   "y": 1138,
   "width": 99,
   "height": 28,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 546411,
   "version": 1,
   "versionNonce": 7226301,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a06-text-70",
   "type": "text",
   "x": 18,
   "y": 1176,
   "width": 1571,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 554330,
   "version": 1,
   "versionNonce": 7331030,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Node protection runs the same TI-LFA walk, but on a map with router E removed and with the check \"every old path avoids router E\". The repair then survives the whole\nnext-hop router failing. Turn it on with protection: node.",
   "originalText": "Node protection runs the same TI-LFA walk, but on a map with router E removed and with the check \"every old path avoids router E\". The repair then survives the whole\nnext-hop router failing. Turn it on with protection: node.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a06-text-71",
   "type": "text",
   "x": 0,
   "y": 1251,
   "width": 1282,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
