  },
  {
   "id": "a06-text-64",
   "type": "text",
   "x": 1125,
   "y": 782,
   "width": 272,
   "height": 28,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 506816,
   "version": 1,
   "versionNonce": 6702656,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 6 in node mode",
   "originalText": "Example 6 in node mode",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a06-text-65",
   "type": "text",
   "x": 1125,
   "y": 820,
   "width": 477,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 514735,
   "version": 1,
   "versionNonce": 6807385,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S’s LFA N reaches D through E (A2). With E removed\nthe path is S → N → M → D (1 + 10 + 10 = 21).",
   "originalText": "S’s LFA N reaches D through E (A2). With E removed\nthe path is S → N → M → D (1 + 10 + 10 = 21).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a06-text-66",
   "type": "text",
   "x": 1125,
   "y": 873,
   "width": 369,
   "height": 38,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 522654,
   "version": 1,
   "versionNonce": 6912114,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "From S: M  11 = 11 ✓   11 < 1 + 11 = 12 ✓\nFrom M: D  10 = 10 ✓   10 < 11 + 1 = 12 ✓",
   "originalText": "From S: M  11 = 11 ✓   11 < 1 + 11 = 12 ✓\nFrom M: D  10 = 10 ✓   10 < 11 + 1 = 12 ✓",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a06-text-67",
   "type": "text",
   "x": 1125,
   "y": 921,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 530573,
   "version": 1,
   "versionNonce": 7016843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "[PrefixSID(M), PrefixSID(D)] = 16004, 16005. With\nrouter E down, traffic is delivered on S → N → M → D\ninstead of looping.",
   "originalText": "[PrefixSID(M), PrefixSID(D)] = 16004, 16005. With\nrouter E down, traffic is delivered on S → N → M → D\ninstead of looping.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
