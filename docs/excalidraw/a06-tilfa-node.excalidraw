   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Step 2. Greedy walk, with check (b) changed to \"avoids router E\"",
   "originalText": "Step 2. Greedy walk, with check (b) changed to \"avoids router E\"",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a06-text-14",
   "type": "text",
   "x": 638,
   "y": 287,
   "width": 701,
   "height": 20,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
