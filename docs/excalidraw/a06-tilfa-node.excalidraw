  {
   "id": "a06-text-51",
   "type": "text",
   "x": 18,
   "y": 782,
   "width": 419,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
