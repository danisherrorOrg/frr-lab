  {
   "id": "b01-text-5",
   "type": "text",
   "x": 18,
   "y": 576,
   "width": 359,
   "height": 20,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
