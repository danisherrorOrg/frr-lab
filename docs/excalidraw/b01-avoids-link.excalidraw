   "roundness": null,
   "seed": 39595,
   "version": 1,
   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green: N’s shortest path to D, N→D (10).",
   "originalText": "Green: N’s shortest path to D, N→D (10).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b01-text-6",
   "type": "text",
   "x": 18,
   "y": 606,
   "width": 547,
   "height": 40,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red dashed: the cheapest path from N to D forced through S→E:\nN→S→E→D (15 + 10 + 10 = 35).",
   "originalText": "Red dashed: the cheapest path from N to D forced through S→E:\nN→S→E→D (15 + 10 + 10 = 35).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b01-text-7",
   "type": "text",
   "x": 18,
   "y": 656,
   "width": 449,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "10 < 35, so no shortest path from N to D uses S→E.",
   "originalText": "10 < 35, so no shortest path from N to D uses S→E.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
