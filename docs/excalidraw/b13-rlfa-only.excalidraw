  {
   "id": "b13-text-55",
   "type": "text",
   "x": 18,
   "y": 1039,
   "width": 1600,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Remote LFA is a fallback: S only tunnels to a PQ node when no neighbor is a safe LFA for that destination. On the same failed link, the ring’s C uses LFA A while E uses\nthe tunnel to B. The spaces are always shown, but the tunnel is installed only where it is needed.",
   "originalText": "Remote LFA is a fallback: S only tunnels to a PQ node when no neighbor is a safe LFA for that destination. On the same failed link, the ring’s C uses LFA A while E uses\nthe tunnel to B. The spaces are always shown, but the tunnel is installed only where it is needed.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
