   "roundness": null,
   "seed": 380112,
   "version": 1,
   "versionNonce": 5026992,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In node mode (A6) an LFA that isn’t node-protecting\nstill stops Remote LFA from running. To make Remote\nLFA take over, the LFA policy must rule it out:\nnode_protecting: require (A16).",
   "originalText": "In node mode (A6) an LFA that isn’t node-protecting\nstill stops Remote LFA from running. To make Remote\nLFA take over, the LFA policy must rule it out:\nnode_protecting: require (A16).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b13-text-49",
   "type": "text",
   "x": 571,
   "y": 905,
   "width": 493,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 388031,
   "version": 1,
   "versionNonce": 5131721,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "§15: with both knobs on require, S → D has no LFA left,\nso Remote LFA is used.",
   "originalText": "§15: with both knobs on require, S → D has no LFA left,\nso Remote LFA is used.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
