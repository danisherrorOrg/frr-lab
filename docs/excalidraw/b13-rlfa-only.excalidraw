   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  ECMP-protected pairs (B2) never need Remote LFA\n   either.\n•  No LFA and no PQ node (Example 3): only TI-LFA\n   protects (A5).\n•  The simulation (A9) follows the same order: LFA\n   if there is one, else the PQ tunnel.",
   "originalText": "•  ECMP-protected pairs (B2) never need Remote LFA\n   either.\n•  No LFA and no PQ node (Example 3): only TI-LFA\n   protects (A5).\n•  The simulation (A9) follows the same order: LFA\n   if there is one, else the PQ tunnel.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
