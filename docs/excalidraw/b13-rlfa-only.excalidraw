   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b13-text-6",
   "type": "text",
   "x": 18,
   "y": 626,
   "width": 556,
   "height": 40,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green: D = C has an LFA, A (2 < 1 + 2 = 3). S just sends to A:\nno tunnel.",
   "originalText": "Green: D = C has an LFA, A (2 < 1 + 2 = 3). S just sends to A:\nno tunnel.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b13-text-7",
   "type": "text",
   "x": 18,
   "y": 676,
   "width": 556,
   "height": 40,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Teal: D = E has no LFA (2 = 1 + 1). Only here does S tunnel to\nPQ node B (label 16004), which forwards B → C → E.",
   "originalText": "Teal: D = E has no LFA (2 = 1 + 1). Only here does S tunnel to\nPQ node B (label 16004), which forwards B → C → E.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
