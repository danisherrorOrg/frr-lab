   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red dashed: the failed link S–E. PQ = {B, C}, best B, for both\nrows.",
   "originalText": "Red dashed: the failed link S–E. PQ = {B, C}, best B, for both\nrows.",
   "fontSize": 16,
