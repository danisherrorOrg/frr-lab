   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example          Remote LFA needed   Not needed (an LFA exists)\n---------------  -----------------   --------------------------\n2  ring          10                  10\n4  ISP core      8                   27\n5  leaf-spine    16                  32\n8                9                   24",
   "originalText": "Example          Remote LFA needed   Not needed (an LFA exists)\n---------------  -----------------   --------------------------\n2  ring          10                  10\n4  ISP core      8                   27\n5  leaf-spine    16                  32\n8                9                   24",
