   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 2, every row from S (from the engine)",
   "originalText": "Example 2, every row from S (from the engine)",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b13-text-13",
   "type": "text",
   "x": 638,
   "y": 388,
   "width": 738,
   "height": 113,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 102947,
   "version": 1,
   "versionNonce": 1361477,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D   Link   LFA                          PQ (best)    Remote LFA used?\n--  -----  ---------------------------  -----------  -----------------------------\nC   S–E    A   (2 < 1 + 2 = 3  ✓)       {B, C} (B)   no: LFA A already protects C\nE   S–E    none (2 = 1 + 1  ✗)          {B, C} (B)   yes: tunnel to B, 16004\nB   S–A    E   (2 < 1 + 2 = 3  ✓)       {B, C} (C)   no: LFA E already protects B\nA   S–A    none (2 = 1 + 1  ✗)          {B, C} (C)   yes: tunnel to C, 16005",
   "originalText": "D   Link   LFA                          PQ (best)    Remote LFA used?\n--  -----  ---------------------------  -----------  -----------------------------\nC   S–E    A   (2 < 1 + 2 = 3  ✓)       {B, C} (B)   no: LFA A already protects C\nE   S–E    none (2 = 1 + 1  ✗)          {B, C} (B)   yes: tunnel to B, 16004\nB   S–A    E   (2 < 1 + 2 = 3  ✓)       {B, C} (C)   no: LFA E already protects B\nA   S–A    none (2 = 1 + 1  ✗)          {B, C} (C)   yes: tunnel to C, 16005",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b13-text-14",
   "type": "text",
   "x": 638,
   "y": 511,
   "width": 660,
   "height": 24,
