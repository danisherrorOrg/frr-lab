   "version": 1,
   "versionNonce": 1570935,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TI-LFA mode: nothing unprotected. Ties are then sorted by affected: A–S 12, S–E 12, B–A 8, E–C 8, router S 8.",
   "originalText": "TI-LFA mode: nothing unprotected. Ties are then sorted by affected: A–S 12, S–E 12, B–A 8, E–C 8, router S 8.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
