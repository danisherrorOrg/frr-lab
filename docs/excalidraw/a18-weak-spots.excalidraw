  {
   "id": "a18-text-58",
   "type": "text",
   "x": 18,
   "y": 1124,
   "width": 1562,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 459302,
   "version": 1,
   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Weakest spots ranks every single link and router failure by how much traffic it loses. In Example 3 with LFA only, losing A–S or S–E drops all 12 flows that use it.\nBecause it fails routers too, it finds problems the coverage numbers can’t show, like router E in Example 6.",
   "originalText": "Weakest spots ranks every single link and router failure by how much traffic it loses. In Example 3 with LFA only, losing A–S or S–E drops all 12 flows that use it.\nBecause it fails routers too, it finds problems the coverage numbers can’t show, like router E in Example 6.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
