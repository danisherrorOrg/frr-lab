   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 1, N overloaded, TI-LFA:\nlink E–D   5 of 6 lost\n           (4 unreachable, 1 dropped)",
   "originalText": "Example 1, N overloaded, TI-LFA:\nlink E–D   5 of 6 lost\n           (4 unreachable, 1 dropped)",
