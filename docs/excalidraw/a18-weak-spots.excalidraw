   "roundness": null,
   "seed": 427626,
   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The heat map (A13) counts the pairs each router\nplans for its own links. Weakest spots fails links\nand whole routers, follows every source’s traffic\nacross the failure and counts what really happens to\nit.",
   "originalText": "The heat map (A13) counts the pairs each router\nplans for its own links. Weakest spots fails links\nand whole routers, follows every source’s traffic\nacross the failure and counts what really happens to\nit.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-55",
   "type": "text",
   "x": 1125,
   "y": 987,
   "width": 475,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
