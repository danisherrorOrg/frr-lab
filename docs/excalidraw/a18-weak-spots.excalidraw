   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 3, LFA only (the same in LFA + Remote LFA: no PQ nodes)",
   "originalText": "Example 3, LFA only (the same in LFA + Remote LFA: no PQ nodes)",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-14",
   "type": "text",
   "x": 638,
   "y": 335,
   "width": 558,
   "height": 188,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 110866,
   "version": 1,
   "versionNonce": 1466206,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rank  Failure    Affected  Repaired  Dropped  Unprotected\n----  ---------  --------  --------  -------  -----------\n1     link A–S   12        0         12       12 of 12\n2     link S–E   12        0         12       12 of 12\n3     router S    8        0          8        8 of 8\n4     link B–A    8        4          4        4 of 8\n5     link E–C    8        4          4        4 of 8\n6     router A    6        3          3        3 of 6\n7     router E    6        3          3        3 of 6\n8     link C–B    0        –          –        carries nothing",
   "originalText": "Rank  Failure    Affected  Repaired  Dropped  Unprotected\n----  ---------  --------  --------  -------  -----------\n1     link A–S   12        0         12       12 of 12\n2     link S–E   12        0         12       12 of 12\n3     router S    8        0          8        8 of 8\n4     link B–A    8        4          4        4 of 8\n5     link E–C    8        4          4        4 of 8\n6     router A    6        3          3        3 of 6\n7     router E    6        3          3        3 of 6\n8     link C–B    0        –          –        carries nothing",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-15",
   "type": "text",
   "x": 638,
   "y": 533,
   "width": 977,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
