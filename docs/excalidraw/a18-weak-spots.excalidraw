   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A test checks each count against simulateAllSources()\nfor that one failure.",
   "originalText": "A test checks each count against simulateAllSources()\nfor that one failure.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
