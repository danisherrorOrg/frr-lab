   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each link and router: lost / affected flows when it alone\nfails. Red: every affected flow is lost. Orange: some are.\nGray: none.",
   "originalText": "Each link and router: lost / affected flows when it alone\nfails. Red: every affected flow is lost. Orange: some are.\nGray: none.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-7",
   "type": "text",
   "x": 18,
   "y": 736,
   "width": 529,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
