   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Router counts leave out flows to and from the router itself\n(no backup can save them).",
   "originalText": "Router counts leave out flows to and from the router itself\n(no backup can save them).",
   "fontSize": 16,
   "fontFamily": 2,
