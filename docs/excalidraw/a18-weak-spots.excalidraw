   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How it works: one failure at a time, every router as the source",
   "originalText": "How it works: one failure at a time, every router as the source",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-10",
   "type": "text",
   "x": 638,
   "y": 166,
   "width": 781,
   "height": 22,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 79190,
   "version": 1,
   "versionNonce": 1047290,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A flow = (source W, destination D), D reachable from W. For each link or router X:",
   "originalText": "A flow = (source W, destination D), D reachable from W. For each link or router X:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-11",
   "type": "text",
   "x": 638,
   "y": 198,
   "width": 924,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 87109,
   "version": 1,
   "versionNonce": 1152019,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  affected: flows whose normal path (lowest-id ties) crosses X\n•  then, as in the simulation: repaired, dropped, looped, or unreachable (no path is left at all)",
   "originalText": "•  affected: flows whose normal path (lowest-id ties) crosses X\n•  then, as in the simulation: repaired, dropped, looped, or unreachable (no path is left at all)",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-12",
   "type": "text",
   "x": 638,
   "y": 251,
   "width": 548,
   "height": 40,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 95028,
   "version": 1,
   "versionNonce": 1256748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "unprotected = dropped + looped + unreachable\nsort: unprotected ↓, affected ↓, links before routers, id",
   "originalText": "unprotected = dropped + looped + unreachable\nsort: unprotected ↓, affected ↓, links before routers, id",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a18-text-13",
   "type": "text",
   "x": 638,
   "y": 301,
   "width": 671,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
