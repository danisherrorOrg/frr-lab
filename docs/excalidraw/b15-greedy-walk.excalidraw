   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How many labels",
   "originalText": "How many labels",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b15-text-53",
   "type": "text",
   "x": 571,
   "y": 830,
   "width": 278,
   "height": 105,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "0  first hop is an LFA (Ex. 1)\n1  a PQ node on the path (Ex. 2),\n   or one Adj-SID (Ex. 4)\n2  P and Q adjacent: Prefix + Adj\n   (Ex. 3)\n3+ rare, long detours",
   "originalText": "0  first hop is an LFA (Ex. 1)\n1  a PQ node on the path (Ex. 2),\n   or one Adj-SID (Ex. 4)\n2  P and Q adjacent: Prefix + Adj\n   (Ex. 3)\n3+ rare, long detours",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b15-text-54",
   "type": "text",
   "x": 571,
   "y": 945,
   "width": 493,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 427626,
   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Extra labels = segments − 1 (B17). MSD limits the total\n(A15).",
   "originalText": "Extra labels = segments − 1 (B17). MSD limits the total\n(A15).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
