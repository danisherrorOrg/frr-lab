  {
   "id": "b15-text-52",
   "type": "text",
   "x": 571,
   "y": 792,
   "width": 185,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
