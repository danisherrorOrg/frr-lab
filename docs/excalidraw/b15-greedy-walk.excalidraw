  {
   "id": "b15-text-48",
   "type": "text",
   "x": 18,
   "y": 792,
   "width": 321,
   "height": 28,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 380112,
   "version": 1,
   "versionNonce": 5026992,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why check (b), and why (a)",
   "originalText": "Why check (b), and why (a)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b15-text-49",
   "type": "text",
   "x": 18,
   "y": 830,
   "width": 486,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 388031,
   "version": 1,
   "versionNonce": 5131721,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "(b) is what keeps the repair loop-free: the routers\nalong a segment haven’t switched, so the segment\nmust work on their old tables. It is B1 with X =\ncurrent (node mode: B19).",
   "originalText": "(b) is what keeps the repair loop-free: the routers\nalong a segment haven’t switched, so the segment\nmust work on their old tables. It is B1 with X =\ncurrent (node mode: B19).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b15-text-50",
   "type": "text",
   "x": 18,
   "y": 925,
   "width": 475,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 395950,
   "version": 1,
   "versionNonce": 5236450,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "(a) always holds when (b) does. It is kept because it\nmakes the Explain steps easier to follow.",
   "originalText": "(a) always holds when (b) does. It is kept because it\nmakes the Explain steps easier to follow.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
