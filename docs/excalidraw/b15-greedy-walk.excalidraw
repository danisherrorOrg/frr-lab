   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 4: PE1 → P1, link PE1–P1 fails",
   "originalText": "Example 4: PE1 → P1, link PE1–P1 fails",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
