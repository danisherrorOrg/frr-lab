  },
  {
   "id": "b15-text-60",
   "type": "text",
   "x": 18,
   "y": 1079,
   "width": 1600,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 475140,
   "version": 1,
   "versionNonce": 6283740,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Walk along the post-convergence path and, from where you are, jump to the furthest router whose old shortest paths all avoid the failed link (a Prefix-SID). If not even\nthe next router qualifies, force that one link with an Adj-SID. In Example 4 that gives PrefixSID(P2), then AdjSID(P2→P1).",
   "originalText": "Walk along the post-convergence path and, from where you are, jump to the furthest router whose old shortest paths all avoid the failed link (a Prefix-SID). If not even\nthe next router qualifies, force that one link with an Adj-SID. In Example 4 that gives PrefixSID(P2), then AdjSID(P2→P1).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
