   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Guarantees",
   "originalText": "Guarantees",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b15-text-57",
   "type": "text",
   "x": 1125,
   "y": 830,
   "width": 486,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  Ends: every step moves at least one hop.\n•  Loop-free and costs exactly the post-convergence\n   cost: each Prefix segment follows old paths that\n   avoid S–E and cost the same. A property test\n   checks it on random networks.\n•  Adj-SID labels: B18.",
   "originalText": "•  Ends: every step moves at least one hop.\n•  Loop-free and costs exactly the post-convergence\n   cost: each Prefix segment follows old paths that\n   avoid S–E and cost the same. A property test\n   checks it on random networks.\n•  Adj-SID labels: B18.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
