   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "b12-text-53",
   "type": "text",
   "x": 571,
   "y": 859,
   "width": 309,
   "height": 28,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Fallback and when it runs",
   "originalText": "Fallback and when it runs",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b12-text-54",
   "type": "text",
   "x": 571,
   "y": 897,
   "width": 477,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 427626,
   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  Only with protection: node, only without an LFA\n   (B13), only when D ≠ E (dest-is-next-hop).\n•  No node PQ: use the link PQ of B11 (protects =\n   link, fallback = none). RFC 8102 gives no rule\n   here (D51).",
   "originalText": "•  Only with protection: node, only without an LFA\n   (B13), only when D ≠ E (dest-is-next-hop).\n•  No node PQ: use the link PQ of B11 (protects =\n   link, fallback = none). RFC 8102 gives no rule\n   here (D51).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b12-rectangle-55",
