  {
   "id": "b12-text-8",
   "type": "text",
   "x": 18,
   "y": 713,
   "width": 556,
   "height": 40,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 63352,
   "version": 1,
   "versionNonce": 837832,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red arrows: B’s own path to D is B → C → E → D (3), through E.\nC’s path C → E → D is too (check 2 ✗).",
   "originalText": "Red arrows: B’s own path to D is B → C → E → D (3), through E.\nC’s path C → E → D is too (check 2 ✗).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b12-text-9",
   "type": "text",
   "x": 18,
   "y": 763,
   "width": 556,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
