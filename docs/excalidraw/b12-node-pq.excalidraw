   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green: the tunnel S → A → B avoids E (check 1 ✓).",
   "originalText": "Green: the tunnel S → A → B avoids E (check 1 ✓).",
