   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The §8.1 ring with D behind E, S → D,\nprotection: node",
   "originalText": "The §8.1 ring with D behind E, S → D,\nprotection: node",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b12-text-5",
   "type": "text",
   "x": 18,
   "y": 603,
   "width": 538,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 39595,
   "version": 1,
   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ring S–E–C–B–A–S, every link 1, plus E–D 1 and C–D 4. No LFA\nfor D. Link PQ = {B, C}, best B.",
   "originalText": "Ring S–E–C–B–A–S, every link 1, plus E–D 1 and C–D 4. No LFA\nfor D. Link PQ = {B, C}, best B.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b12-text-6",
   "type": "text",
   "x": 18,
   "y": 653,
   "width": 440,
   "height": 20,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red dashed: router E, the one to protect against.",
   "originalText": "Red dashed: router E, the one to protect against.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b12-text-7",
   "type": "text",
   "x": 18,
   "y": 683,
   "width": 440,
   "height": 20,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
