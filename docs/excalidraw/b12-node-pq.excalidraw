  {
   "id": "b12-text-60",
   "type": "text",
   "x": 18,
   "y": 1068,
   "width": 99,
   "height": 28,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
