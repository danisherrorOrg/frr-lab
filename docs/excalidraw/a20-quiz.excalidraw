  },
  {
   "id": "a20-text-13",
   "type": "text",
   "x": 638,
   "y": 438,
   "width": 615,
   "height": 40,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
