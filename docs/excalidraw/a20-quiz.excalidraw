   "roundness": null,
   "seed": 395950,
   "version": 1,
   "versionNonce": 5236450,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A property test (random networks, random seeds)\nchecks every answer against the engine, that the\nchoices are unique, and that each question has an\nexplanation.",
   "originalText": "A property test (random networks, random seeds)\nchecks every answer against the engine, that the\nchoices are unique, and that each question has an\nexplanation.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
