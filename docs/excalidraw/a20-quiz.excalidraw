   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 2, seed 1: the 10 questions",
   "originalText": "Example 2, seed 1: the 10 questions",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a20-text-45",
   "type": "text",
   "x": 18,
   "y": 840,
   "width": 639,
   "height": 225,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 356355,
   "version": 1,
   "versionNonce": 4712805,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": " #  Kind          Row (S → D, link)   Right answer\n--  ------------  ------------------  ---------------------------------\n 1  method        E → C, E–C          Remote LFA\n 2  label-stack   E → S, S–E          16004 16001\n 3  pq-node       B → C, C–B          S\n 4  q-space       B → S, B–A          Yes (S is in A’s Q-space)\n 5  p-space       S → E, S–E          Yes (A is in S’s P-space)\n 6  extra-labels  B → C, C–B          1\n 7  best-lfa      A → C, B–A          S\n 8  loop-free     B → A, B–A          No (C is not loop-free for A)\n 9  method        S → A, A–S          Remote LFA\n10  label-stack   A → C, B–A          16002 16005",
   "originalText": " #  Kind          Row (S → D, link)   Right answer\n--  ------------  ------------------  ---------------------------------\n 1  method        E → C, E–C          Remote LFA\n 2  label-stack   E → S, S–E          16004 16001\n 3  pq-node       B → C, C–B          S\n 4  q-space       B → S, B–A          Yes (S is in A’s Q-space)\n 5  p-space       S → E, S–E          Yes (A is in S’s P-space)\n 6  extra-labels  B → C, C–B          1\n 7  best-lfa      A → C, B–A          S\n 8  loop-free     B → A, B–A          No (C is not loop-free for A)\n 9  method        S → A, A–S          Remote LFA\n10  label-stack   A → C, B–A          16002 16005",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a20-text-46",
   "type": "text",
   "x": 18,
   "y": 1075,
   "width": 959,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Seed 2 starts with label-stack A → S, then method C → E. Running seed 1 again gives exactly the list above.",
   "originalText": "Seed 2 starts with label-stack A → S, then method C → E. Running seed 1 again gives exactly the list above.",
   "fontSize": 16,
   "fontFamily": 2,
