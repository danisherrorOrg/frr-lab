   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The quiz decides nothing. Each answer is a field the\nresults table already shows, and each \"why\" is that\nrow’s explain steps.",
   "originalText": "The quiz decides nothing. Each answer is a field the\nresults table already shows, and each \"why\" is that\nrow’s explain steps.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
