   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Edge cases",
   "originalText": "Edge cases",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b09-text-60",
   "type": "text",
   "x": 1125,
   "y": 805,
   "width": 467,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 475140,
   "version": 1,
   "versionNonce": 6283740,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  Exits skipped (B6, A17): a neighbor whose link\n   has the max metric, or with the overload bit.\n•  On by default (D5). The sidebar box \"Extended\n   P-space (RLFA)\" switches to plain P-space.\n•  Only used to find PQ nodes. LFA itself never\n   tunnels.",
   "originalText": "•  Exits skipped (B6, A17): a neighbor whose link\n   has the max metric, or with the overload bit.\n•  On by default (D5). The sidebar box \"Extended\n   P-space (RLFA)\" switches to plain P-space.\n•  Only used to find PQ nodes. LFA itself never\n   tunnels.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b09-rectangle-61",
