  {
   "id": "b09-text-55",
   "type": "text",
   "x": 571,
   "y": 767,
   "width": 284,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Two formulas in the RFC",
   "originalText": "Two formulas in the RFC",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b09-text-56",
   "type": "text",
   "x": 571,
   "y": 805,
   "width": 477,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "RFC 7490 §5.2.1.2 (prose): dist(N,Y) < dist(N,S) +\nc(S,E) + dist(E,Y). The §5.3 pseudocode uses\nInequality 1, as here.",
   "originalText": "RFC 7490 §5.2.1.2 (prose): dist(N,Y) < dist(N,S) +\nc(S,E) + dist(E,Y). The §5.3 pseudocode uses\nInequality 1, as here.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b09-text-57",
   "type": "text",
   "x": 571,
   "y": 879,
   "width": 493,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D17: once P(S) is added, both give the same set. A node\npassing only the prose test is a tie in Inequality 1,\nand then it is already in P(S).",
   "originalText": "D17: once P(S) is added, both give the same set. A node\npassing only the prose test is a tie in Inequality 1,\nand then it is already in P(S).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
