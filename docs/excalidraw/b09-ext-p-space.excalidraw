   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Which neighbor is the exit",
   "originalText": "Which neighbor is the exit",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b09-text-52",
   "type": "text",
   "x": 18,
   "y": 805,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If Y is in the P-space of several neighbors, use the\ncheapest way in: lowest c(S,N) + dist(N,Y), then\nlowest router id.",
   "originalText": "If Y is in the P-space of several neighbors, use the\ncheapest way in: lowest c(S,N) + dist(N,Y), then\nlowest router id.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b09-text-53",
   "type": "text",
   "x": 18,
   "y": 879,
   "width": 493,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 8: B via N costs 2 + 3 = 5, C via N costs 2 + 6\n= 8. Example 4: PE2 via P2 costs 10 + 20 = 30. These\ncosts pick the PQ node (B11).",
   "originalText": "Example 8: B via N costs 2 + 3 = 5, C via N costs 2 + 6\n= 8. Example 4: PE2 via P2 costs 10 + 20 = 30. These\ncosts pick the PQ node (B11).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
