   "versionNonce": 1780393,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In Examples 4 and 8, Remote LFA only works with extended P-space. In the ring the choice stays B either way\n(B11).",
   "originalText": "In Examples 4 and 8, Remote LFA only works with extended P-space. In the ring the choice stays B either way\n(B11).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
