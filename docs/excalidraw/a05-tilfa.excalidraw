   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The list ends with PrefixSID(D) (B17)",
   "originalText": "The list ends with PrefixSID(D) (B17)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-63",
   "type": "text",
   "x": 18,
   "y": 1143,
   "width": 477,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 498897,
   "version": 1,
   "versionNonce": 6597927,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "That is the packet’s own label: it stays under the\nrepair labels (RFC 9855 §7.1). If the walk ends on\nan Adj-SID into D, PrefixSID(D) is added after it.",
   "originalText": "That is the packet’s own label: it stays under the\nrepair labels (RFC 9855 §7.1). If the walk ends on\nan Adj-SID into D, PrefixSID(D) is added after it.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-64",
