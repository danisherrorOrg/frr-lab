   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The repair always leaves on the first link anyway,\nso a first segment that only reaches the first hop N\nis dropped (RFC 9855 §5.1):",
   "originalText": "The repair always leaves on the first link anyway,\nso a first segment that only reaches the first hop N\nis dropped (RFC 9855 §5.1):",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-55",
