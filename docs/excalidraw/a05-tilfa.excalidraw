   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "From S: C? old path S→E→C uses S–E\n        B: 2 < 0 + 1 + 2 = 3  ✓\nFrom B: E: 2 < 2 + 1 + 0 = 3  ✓",
   "originalText": "From S: C? old path S→E→C uses S–E\n        B: 2 < 0 + 1 + 2 = 3  ✓\nFrom B: E: 2 < 2 + 1 + 0 = 3  ✓",
   "fontSize": 15,
   "fontFamily": 3,
