   "version": 1,
   "versionNonce": 6283740,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Too many for S’s Max SID depth? The repair can’t be\ninstalled (A15).",
   "originalText": "Too many for S’s Max SID depth? The repair can’t be\ninstalled (A15).",
   "fontSize": 16,
