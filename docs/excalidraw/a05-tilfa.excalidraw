   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PrefixSID(B) = 16000 + 4 = 16004    AdjSID(B→C) = 24005 (from the YAML)    PrefixSID(E) = 16002\nstack, top first:  16004  24005  16002      sent out to A      extra labels = 3 − 1 = 2",
   "originalText": "PrefixSID(B) = 16000 + 4 = 16004    AdjSID(B→C) = 24005 (from the YAML)    PrefixSID(E) = 16002\nstack, top first:  16004  24005  16002      sent out to A      extra labels = 3 − 1 = 2",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
