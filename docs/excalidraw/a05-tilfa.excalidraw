   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green arrows: the post-convergence path S → A → B → C → E (1 +\n1 + 10 + 1 = 13).",
   "originalText": "Green arrows: the post-convergence path S → A → B → C → E (1 +\n1 + 10 + 1 = 13).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
