   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 593925,
   "version": 1,
   "versionNonce": 7854675,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TI-LFA stops hoping a router’s normal path avoids the failure. It takes the post-convergence path and writes it as a few labels: Prefix-SIDs where old shortest paths\nare safe, an Adj-SID where they aren’t. So it protects every destination that can still be reached.",
   "originalText": "TI-LFA stops hoping a router’s normal path avoids the failure. It takes the post-convergence path and writes it as a few labels: Prefix-SIDs where old shortest paths\nare safe, an Adj-SID where they aren’t. So it protects every destination that can still be reached.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
