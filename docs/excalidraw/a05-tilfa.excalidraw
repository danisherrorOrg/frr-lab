   "roundness": null,
   "seed": 63352,
   "version": 1,
   "versionNonce": 837832,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Orange 10: B–C is forced with B’s Adj-SID 24005; no shortest\npath uses it.",
