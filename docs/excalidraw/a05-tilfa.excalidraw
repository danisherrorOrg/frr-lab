   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ties and labels (B14, B18)",
   "originalText": "Ties and labels (B14, B18)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-67",
   "type": "text",
   "x": 571,
   "y": 1143,
   "width": 448,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 530573,
   "version": 1,
   "versionNonce": 7016843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Equal post-convergence paths: lowest router ids\nalong the path win.",
   "originalText": "Equal post-convergence paths: lowest router ids\nalong the path win.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-68",
   "type": "text",
   "x": 571,
   "y": 1196,
   "width": 457,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 538492,
   "version": 1,
   "versionNonce": 7121572,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Prefix-SID = SRGB 16000 + SID index (same SRGB\neverywhere). Adj-SIDs from the YAML, or numbered\nfrom 24000 per router in neighbor-id order.",
   "originalText": "Prefix-SID = SRGB 16000 + SID index (same SRGB\neverywhere). Adj-SIDs from the YAML, or numbered\nfrom 24000 per router in neighbor-id order.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
