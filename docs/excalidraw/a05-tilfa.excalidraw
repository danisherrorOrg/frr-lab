   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why it always works",
   "originalText": "Why it always works",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-71",
   "type": "text",
   "x": 1125,
   "y": 1143,
   "width": 486,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 562249,
   "version": 1,
   "versionNonce": 7435759,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each step moves forward (an Adj-SID moves at least\none hop), so the walk ends. Each Prefix-SID segment\nfollows old paths that avoid S–E, so the repair is\nloop-free and costs exactly the post-convergence\ncost.",
   "originalText": "Each step moves forward (an Adj-SID moves at least\none hop), so the walk ends. Each Prefix-SID segment\nfollows old paths that avoid S–E, so the repair is\nloop-free and costs exactly the post-convergence\ncost.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-72",
   "type": "text",
   "x": 1125,
   "y": 1260,
   "width": 466,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 570168,
   "version": 1,
   "versionNonce": 7540488,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Only fails if D can’t be reached at all without S–E.",
   "originalText": "Only fails if D can’t be reached at all without S–E.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
