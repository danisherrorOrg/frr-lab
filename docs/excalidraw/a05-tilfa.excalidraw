  {
   "id": "a05-text-59",
   "type": "text",
   "x": 1125,
   "y": 867,
   "width": 333,
   "height": 132,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Extra  When\n-----  ------------------------------\n0      the first hop is an LFA\n1      a PQ node is on the path\n2      P and Q are adjacent:\n       Prefix-SID + Adj-SID (Ex. 3)\n3+     rare, long detours",
   "originalText": "Extra  When\n-----  ------------------------------\n0      the first hop is an LFA\n1      a PQ node is on the path\n2      P and Q are adjacent:\n       Prefix-SID + Adj-SID (Ex. 3)\n3+     rare, long detours",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a05-text-60",
   "type": "text",
   "x": 1125,
   "y": 1009,
   "width": 457,
