   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Square. Path S → N → D. The walk gives\n[PrefixSID(N), PrefixSID(D)].",
   "originalText": "Square. Path S → N → D. The walk gives\n[PrefixSID(N), PrefixSID(D)].",
   "fontSize": 17,
   "fontFamily": 2,
