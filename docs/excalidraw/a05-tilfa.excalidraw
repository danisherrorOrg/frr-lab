   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "[PrefixSID(B), PrefixSID(E)] = 16004, 16002, out via\nA. The same as Remote LFA’s tunnel to B (A3).",
   "originalText": "[PrefixSID(B), PrefixSID(E)] = 16004, 16002, out via\nA. The same as Remote LFA’s tunnel to B (A3).",
