   "lineHeight": 1.25
  },
  {
   "id": "a05-text-8",
   "type": "text",
   "x": 18,
   "y": 733,
   "width": 538,
   "height": 40,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
