   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "When the first hop is an LFA, TI-LFA just sends to it.",
   "originalText": "When the first hop is an LFA, TI-LFA just sends to it.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
