   "frameId": null,
   "roundness": null,
   "seed": 142542,
   "version": 1,
   "versionNonce": 1885122,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S puts the packet in a tunnel to B. B is reached without S–E (P) and reaches E without S–E (Q), so B\njust forwards it on its normal table. With Segment Routing the tunnel is B’s Prefix-SID: 16000 + 4 =\n16004.",
   "originalText": "S puts the packet in a tunnel to B. B is reached without S–E (P) and reaches E without S–E (Q), so B\njust forwards it on its normal table. With Segment Routing the tunnel is B’s Prefix-SID: 16000 + 4 =\n16004.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
