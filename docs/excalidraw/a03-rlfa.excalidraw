   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How it works: find routers in both P-space and Q-space",
   "originalText": "How it works: find routers in both P-space and Q-space",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
