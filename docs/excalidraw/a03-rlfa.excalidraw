   "versionNonce": 9216152,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Only when there is no LFA (B13)",
   "originalText": "Only when there is no LFA (B13)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a03-text-89",
   "type": "text",
   "x": 18,
   "y": 1434,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 704791,
   "version": 1,
   "versionNonce": 9320881,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Remote LFA is used only if (D, link S–E) has no LFA.\nThe P, Q and PQ sets are still shown in LFA Lab, for\nlearning.",
   "originalText": "Remote LFA is used only if (D, link S–E) has no LFA.\nThe P, Q and PQ sets are still shown in LFA Lab, for\nlearning.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a03-text-90",
   "type": "text",
   "x": 18,
   "y": 1508,
   "width": 413,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 712710,
   "version": 1,
   "versionNonce": 9425610,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Order: ECMP → LFA → Remote LFA → TI-LFA (B20).",
   "originalText": "Order: ECMP → LFA → Remote LFA → TI-LFA (B20).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
