   "versionNonce": 1675664,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B  in plain P(S):  dist(S,B)            = 2   ← chosen\nC  only via A:     c(S,A) + dist(A,C)   = 1 + 2 = 3",
   "originalText": "B  in plain P(S):  dist(S,B)            = 2   ← chosen\nC  only via A:     c(S,A) + dist(A,C)   = 1 + 2 = 3",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
