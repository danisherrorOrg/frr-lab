   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What the tunnel is",
   "originalText": "What the tunnel is",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a03-text-93",
   "type": "text",
   "x": 571,
   "y": 1434,
   "width": 477,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 736467,
   "version": 1,
   "versionNonce": 9739797,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "RFC 7490 allows any tunnel. Older networks used an\nLDP label over a targeted LDP session.",
   "originalText": "RFC 7490 allows any tunnel. Older networks used an\nLDP label over a targeted LDP session.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a03-text-94",
   "type": "text",
   "x": 571,
   "y": 1487,
   "width": 486,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 744386,
   "version": 1,
   "versionNonce": 9844526,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "With Segment Routing it is just one more label: the\nPQ node’s Prefix-SID (16004 for B).",
   "originalText": "With Segment Routing it is just one more label: the\nPQ node’s Prefix-SID (16004 for B).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
