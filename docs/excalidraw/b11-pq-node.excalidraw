  {
   "id": "b11-text-6",
   "type": "text",
   "x": 18,
   "y": 606,
   "width": 547,
   "height": 40,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Teal arrows: the tunnel PE1 → P2 → P4 → PE2, sent out through\nP2 (cost 30). One label: PE2’s Prefix-SID 16012.",
   "originalText": "Teal arrows: the tunnel PE1 → P2 → P4 → PE2, sent out through\nP2 (cost 30). One label: PE2’s Prefix-SID 16012.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b11-text-7",
   "type": "text",
   "x": 18,
   "y": 656,
   "width": 547,
   "height": 40,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Purple arrows: PE2 takes the label off and forwards normally,\nPE2 → P3 → P1 (20), then on to D.",
   "originalText": "Purple arrows: PE2 takes the label off and forwards normally,\nPE2 → P3 → P1 (20), then on to D.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
