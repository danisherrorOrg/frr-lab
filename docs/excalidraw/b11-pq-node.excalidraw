   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  A router with the overload bit, even in both\n   spaces (RFC 7490 §5.4, listed as overloadedPq).\n•  S and E: never in any space (D17).\n•  A PQ node reached only through a max-metric or\n   overloaded neighbor (B6, B9).",
   "originalText": "•  A router with the overload bit, even in both\n   spaces (RFC 7490 §5.4, listed as overloadedPq).\n•  S and E: never in any space (D17).\n•  A PQ node reached only through a max-metric or\n   overloaded neighbor (B6, B9).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
