  },
  {
   "id": "b11-text-59",
   "type": "text",
   "x": 571,
   "y": 798,
   "width": 477,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
