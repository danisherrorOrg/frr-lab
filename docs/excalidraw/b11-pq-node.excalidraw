  {
   "id": "b11-text-55",
   "type": "text",
   "x": 18,
   "y": 798,
   "width": 448,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
