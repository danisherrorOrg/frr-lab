   "text": "Example 4: link PE1–P1, the PQ node is PE2",
   "originalText": "Example 4: link PE1–P1, the PQ node is PE2",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b11-text-5",
