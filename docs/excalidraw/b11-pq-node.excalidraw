  },
  {
   "id": "b11-text-62",
   "type": "text",
   "x": 1125,
   "y": 798,
   "width": 496,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 490978,
   "version": 1,
   "versionNonce": 6493198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PQ nodes are worked out and shown on every row, for\nteaching. The tunnel is installed only when there is\nno LFA. With no PQ node at all, TI-LFA (A5) still\nrepairs.",
   "originalText": "PQ nodes are worked out and shown on every row, for\nteaching. The tunnel is installed only when there is\nno LFA. With no PQ node at all, TI-LFA (A5) still\nrepairs.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
