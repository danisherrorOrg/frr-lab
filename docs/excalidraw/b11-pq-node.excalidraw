   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Never a tunnel end",
   "originalText": "Never a tunnel end",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
