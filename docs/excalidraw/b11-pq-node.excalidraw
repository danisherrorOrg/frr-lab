   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "P and Q don’t mention D, so the choice doesn’t\neither. PE2 serves PE1 → P1 and PE1 → P3 alike.",
   "originalText": "P and Q don’t mention D, so the choice doesn’t\neither. PE2 serves PE1 → P1 and PE1 → P3 alike.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b11-text-56",
   "type": "text",
   "x": 18,
   "y": 851,
   "width": 466,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Node protection (B12) is the exception: it is chosen\nper D.",
   "originalText": "Node protection (B12) is the exception: it is chosen\nper D.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
