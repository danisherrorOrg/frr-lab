   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why: free hosting, no privacy worries,\nworks in a lab with no internet (D1).",
   "originalText": "Why: free hosting, no privacy worries,\nworks in a lab with no internet (D1).",
   "fontSize": 16,
   "fontFamily": 2,
