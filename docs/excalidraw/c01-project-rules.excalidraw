   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1 · The engine is pure",
   "originalText": "1 · The engine is pure",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-35",
   "type": "text",
   "x": 18,
   "y": 380,
   "width": 343,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 277165,
   "version": 1,
   "versionNonce": 3665515,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "src/engine/ has no React, no DOM, no\nwindow, no randomness. Same input →\nsame output.",
   "originalText": "src/engine/ has no React, no DOM, no\nwindow, no randomness. Same input →\nsame output.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-36",
   "type": "text",
   "x": 18,
   "y": 454,
   "width": 359,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 285084,
   "version": 1,
   "versionNonce": 3770244,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why: it runs in a Web Worker for the UI\nand in Node for the tests, and can\nbecome an npm package or CLI later (D2).",
   "originalText": "Why: it runs in a Web Worker for the UI\nand in Node for the tests, and can\nbecome an npm package or CLI later (D2).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-37",
   "type": "text",
   "x": 18,
   "y": 524,
   "width": 244,
   "height": 88,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
