   "versionNonce": 4293889,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why: the numbers are what users learn\nfrom. A wrong number teaches the wrong\nthing.",
   "originalText": "Why: the numbers are what users learn\nfrom. A wrong number teaches the wrong\nthing.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
