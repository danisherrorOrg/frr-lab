   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-73",
   "type": "text",
   "x": 18,
   "y": 993,
   "width": 1543,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 578087,
   "version": 1,
   "versionNonce": 7645217,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The rules keep the numbers right and the app simple: a pure engine checked by tests, the RFC as the referee, work done in roadmap order, and a static site with no\nbackend and few dependencies. Most rules are enforced by tools (ESLint, 864 tests, CI on every push), not just by trust.",
   "originalText": "The rules keep the numbers right and the app simple: a pure engine checked by tests, the RFC as the referee, work done in roadmap order, and a static site with no\nbackend and few dependencies. Most rules are enforced by tools (ESLint, 864 tests, CI on every push), not just by trust.",
   "fontSize": 17,
