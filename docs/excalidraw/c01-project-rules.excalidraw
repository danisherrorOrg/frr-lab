   "roundness": null,
   "seed": 293003,
   "version": 1,
   "versionNonce": 3874973,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ESLint in src/engine/ blocks:\n react, ui/, state/, worker/\n browser globals (window…)\n Math.random, Date.now,\n new Date()",
   "originalText": "ESLint in src/engine/ blocks:\n react, ui/, state/, worker/\n browser globals (window…)\n Math.random, Date.now,\n new Date()",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
