   "version": 1,
   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why: each phase builds on the last:\nTI-LFA needs SPF and the avoid-check\n(B1) to be right first.",
   "originalText": "Why: each phase builds on the last:\nTI-LFA needs SPF and the avoid-check\n(B1) to be right first.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
