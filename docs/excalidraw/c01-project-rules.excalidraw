   "roundness": null,
   "seed": 514735,
   "version": 1,
   "versionNonce": 6807385,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A request for a plan or requirements\nmeans docs only. No code until asked.",
   "originalText": "A request for a plan or requirements\nmeans docs only. No code until asked.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-66",
   "type": "text",
   "x": 848,
   "y": 759,
   "width": 305,
   "height": 60,
   "angle": 0,
