  },
  {
   "id": "c01-text-70",
   "type": "text",
   "x": 1263,
   "y": 706,
   "width": 353,
   "height": 170,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
