   "versionNonce": 4189160,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every algorithm change needs a test.\nThe worked examples in §6 of\n02-algorithms.md must keep passing.",
   "originalText": "Every algorithm change needs a test.\nThe worked examples in §6 of\n02-algorithms.md must keep passing.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-41",
   "type": "text",
   "x": 433,
   "y": 454,
   "width": 341,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
