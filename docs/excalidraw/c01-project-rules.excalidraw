   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SPF → LFA → Remote LFA\n → TI-LFA → coverage → UI\n → simulation → feedback\n → launch\n52 boxes ticked, 0 open",
   "originalText": "SPF → LFA → Remote LFA\n → TI-LFA → coverage → UI\n → simulation → feedback\n → launch\n52 boxes ticked, 0 open",
