   "frameId": null,
   "roundness": null,
   "seed": 522654,
   "version": 1,
   "versionNonce": 6912114,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why: a plan is cheap to review and\nchange. Code written too early is\nwasted.",
   "originalText": "Why: a plan is cheap to review and\nchange. Code written too early is\nwasted.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-67",
