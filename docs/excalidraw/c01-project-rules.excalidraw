   "roundness": null,
   "seed": 554330,
   "version": 1,
   "versionNonce": 7331030,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  Strict TypeScript, small pure\n   functions, named exports.\n•  Comments say why and cite the RFC,\n   e.g. // RFC 7490 §5.2.1.\n•  UI text: short, plain English,\n   with real numbers.\n•  No AI attribution in commits or\n   PRs.",
   "originalText": "•  Strict TypeScript, small pure\n   functions, named exports.\n•  Comments say why and cite the RFC,\n   e.g. // RFC 7490 §5.2.1.\n•  UI text: short, plain English,\n   with real numbers.\n•  No AI attribution in commits or\n   PRs.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
