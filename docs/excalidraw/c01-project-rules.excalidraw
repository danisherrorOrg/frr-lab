  {
   "id": "c01-text-51",
   "type": "text",
   "x": 1263,
   "y": 454,
   "width": 323,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
