   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "7 · Plan vs build",
   "originalText": "7 · Plan vs build",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "c01-text-65",
   "type": "text",
   "x": 848,
   "y": 706,
   "width": 353,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
