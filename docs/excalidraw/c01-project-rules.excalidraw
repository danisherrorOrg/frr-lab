   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why: every package is code to trust,\nupdate and ship to the browser.",
   "originalText": "Why: every package is code to trust,\nupdate and ship to the browser.",
