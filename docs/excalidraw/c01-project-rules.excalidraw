   "versionNonce": 7016843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "plan = docs/01 … 05\n requirements, algorithms,\n architecture, roadmap,\n testing",
