   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If code, docs and RFC disagree:\nfollow the RFC, fix 02-algorithms.md,\nadd a DECISIONS.md entry.",
   "originalText": "If code, docs and RFC disagree:\nfollow the RFC, fix 02-algorithms.md,\nadd a DECISIONS.md entry.",
