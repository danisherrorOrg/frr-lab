  {
   "id": "a07-text-68",
   "type": "text",
   "x": 1125,
   "y": 981,
   "width": 321,
   "height": 28,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
