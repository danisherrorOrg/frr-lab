   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Under each link: the label stack on the wire, top first. Blue = Prefix-SID, orange = Adj-SID, purple = the destination’s own label (16002 = E).",
   "originalText": "Under each link: the label stack on the wire, top first. Blue = Prefix-SID, orange = Adj-SID, purple = the destination’s own label (16002 = E).",
