   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At S (the repairing router)",
   "originalText": "At S (the repairing router)",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-52",
   "type": "text",
   "x": 918,
   "y": 644,
   "width": 667,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The packet already carries D’s label. S pushes the rest of the segment\nlist on top and sends it out of the repair link (RFC 9855 §5).",
   "originalText": "The packet already carries D’s label. S pushes the rest of the segment\nlist on top and sends it out of the repair link (RFC 9855 §5).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-53",
   "type": "text",
   "x": 918,
   "y": 697,
   "width": 426,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every other router R reads the top label",
   "originalText": "Every other router R reads the top label",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-54",
   "type": "text",
   "x": 918,
   "y": 731,
   "width": 657,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 427626,
   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  its own Prefix-SID: pop it, read the next one\n•  its own Adj-SID R→X: pop it, send on that link, whatever its table\n   says (RFC 8402 §3.4)\n•  router Y’s Prefix-SID: forward on its normal table, checked by\n   c(R,next) + dist(next,Y) = dist(R,Y)",
   "originalText": "•  its own Prefix-SID: pop it, read the next one\n•  its own Adj-SID R→X: pop it, send on that link, whatever its table\n   says (RFC 8402 §3.4)\n•  router Y’s Prefix-SID: forward on its normal table, checked by\n   c(R,next) + dist(next,Y) = dist(R,Y)",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-55",
   "type": "text",
   "x": 918,
   "y": 848,
   "width": 203,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PHP (on by default)",
   "originalText": "PHP (on by default)",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-56",
   "type": "text",
   "x": 918,
   "y": 882,
   "width": 638,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If the top label is the next router’s own Prefix-SID, pop it before\nsending (RFC 8660 §2). So D gets a plain IP packet.",
   "originalText": "If the top label is the next router’s own Prefix-SID, pop it before\nsending (RFC 8660 §2). So D gets a plain IP packet.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
