   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "16004 = B: to B\n1 + 0 = 1 ✓\nPHP: pop 16004",
   "originalText": "16004 = B: to B\n1 + 0 = 1 ✓\nPHP: pop 16004",
   "fontSize": 16,
   "fontFamily": 2,
