   "versionNonce": 6388469,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Same path, same cost 13.",
   "originalText": "Same path, same cost 13.",
   "fontSize": 16,
   "fontFamily": 2,
