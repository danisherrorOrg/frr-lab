   "versionNonce": 7121572,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What the walk is and isn’t",
   "originalText": "What the walk is and isn’t",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-69",
   "type": "text",
   "x": 1125,
   "y": 1019,
   "width": 486,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 546411,
   "version": 1,
   "versionNonce": 7226301,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A teaching view: it changes no result. It ends at D\nwith no labels left.",
   "originalText": "A teaching view: it changes no result. It ends at D\nwith no labels left.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-70",
   "type": "text",
   "x": 1125,
   "y": 1072,
   "width": 486,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 554330,
   "version": 1,
   "versionNonce": 7331030,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "With ECMP a real router may pick another equal-cost\nnext hop; the walk shows the one on the\npost-convergence path.",
   "originalText": "With ECMP a real router may pick another equal-cost\nnext hop; the walk shows the one on the\npost-convergence path.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-71",
   "type": "text",
   "x": 1125,
   "y": 1146,
   "width": 493,
   "height": 40,
   "angle": 0,
