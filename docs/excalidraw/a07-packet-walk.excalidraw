   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Primary path walk (Example 2, S → C)",
   "originalText": "Primary path walk (Example 2, S → C)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
