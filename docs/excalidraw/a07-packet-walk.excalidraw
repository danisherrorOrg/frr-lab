   "roundness": null,
   "seed": 340517,
   "version": 1,
   "versionNonce": 4503347,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "16002 = E: to E\n1 + 0 = 1 ✓\nPHP: pop 16002",
   "originalText": "16002 = E: to E\n1 + 0 = 1 ✓\nPHP: pop 16002",
