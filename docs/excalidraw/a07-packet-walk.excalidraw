   "roundness": null,
   "seed": 562249,
   "version": 1,
   "versionNonce": 7435759,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Labels: Prefix-SID = 16000 + index, Adj-SIDs from 24000\n(B18).",
   "originalText": "Labels: Prefix-SID = 16000 + index, Adj-SIDs from 24000\n(B18).",
   "fontSize": 16,
