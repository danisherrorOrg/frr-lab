   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "a07-text-58",
   "type": "text",
   "x": 18,
   "y": 981,
   "width": 148,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
