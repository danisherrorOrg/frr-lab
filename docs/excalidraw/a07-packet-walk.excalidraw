  },
  {
   "id": "a07-text-64",
   "type": "text",
   "x": 571,
   "y": 1019,
   "width": 496,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 506816,
   "version": 1,
   "versionNonce": 6702656,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nothing has failed, so every router, S too, forwards\non D’s Prefix-SID.",
   "originalText": "Nothing has failed, so every router, S too, forwards\non D’s Prefix-SID.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-65",
   "type": "text",
   "x": 571,
   "y": 1072,
   "width": 342,
   "height": 57,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 514735,
   "version": 1,
   "versionNonce": 6807385,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S: 16005 → E   1 + 1 = 2 = dist(S,C) ✓\nE: next is C → PHP pop 16005\nC: plain packet, delivered    total 2",
   "originalText": "S: 16005 → E   1 + 1 = 2 = dist(S,C) ✓\nE: next is C → PHP pop 16005\nC: plain packet, delivered    total 2",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-66",
   "type": "text",
   "x": 571,
   "y": 1139,
   "width": 431,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
