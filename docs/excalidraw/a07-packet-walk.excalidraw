   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "With PHP off",
   "originalText": "With PHP off",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-59",
   "type": "text",
   "x": 18,
   "y": 1019,
   "width": 429,
   "height": 22,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each segment’s end router pops its own label:",
   "originalText": "Each segment’s end router pops its own label:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-60",
   "type": "text",
   "x": 18,
   "y": 1051,
   "width": 477,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 475140,
   "version": 1,
   "versionNonce": 6283740,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  A sends all three labels to B.\n•  B pops 16004 (its own), then its Adj-SID 24005.\n•  C forwards 16002 to E.\n•  E pops 16002 and delivers.",
   "originalText": "•  A sends all three labels to B.\n•  B pops 16004 (its own), then its Adj-SID 24005.\n•  C forwards 16002 to E.\n•  E pops 16002 and delivers.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-61",
   "type": "text",
   "x": 18,
   "y": 1146,
   "width": 216,
   "height": 20,
