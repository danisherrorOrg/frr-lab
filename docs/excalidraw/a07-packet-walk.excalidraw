   "roundness": null,
   "seed": 522654,
   "version": 1,
   "versionNonce": 6912114,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The detail panel lets you pick \"Primary path\" or\n\"TI-LFA backup\".",
   "originalText": "The detail panel lets you pick \"Primary path\" or\n\"TI-LFA backup\".",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
