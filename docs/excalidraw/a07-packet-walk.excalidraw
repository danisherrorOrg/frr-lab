  {
   "id": "a07-text-46",
   "type": "text",
   "x": 18,
   "y": 572,
   "width": 469,
   "height": 28,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Hop by hop (what packetWalk() records)",
   "originalText": "Hop by hop (what packetWalk() records)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-47",
   "type": "text",
   "x": 18,
   "y": 610,
   "width": 783,
   "height": 207,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 372193,
   "version": 1,
   "versionNonce": 4922263,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Router  Arrives with        Does                                      Leaves with\n------  ------------------  ----------------------------------------  -----------------\nS       16002               push 16004, 24005; out of the repair      16004 24005 16002\n                            link to A (S doesn’t read the top label)\nA       16004 24005 16002   16004 is B’s: forward to B,               24005 16002\n                            c(A,B) + dist(B,B) = 1 + 0 = dist(A,B) ✓\n                            next router is B, so PHP pops 16004\nB       24005 16002         its own Adj-SID: pop, send on B→C (10)    16002\nC       16002               16002 is E’s: forward to E, 1 + 0 = 1 ✓   no labels\n                            next router is E, so PHP pops 16002\nE       no labels           deliver                                   –",
   "originalText": "Router  Arrives with        Does                                      Leaves with\n------  ------------------  ----------------------------------------  -----------------\nS       16002               push 16004, 24005; out of the repair      16004 24005 16002\n                            link to A (S doesn’t read the top label)\nA       16004 24005 16002   16004 is B’s: forward to B,               24005 16002\n                            c(A,B) + dist(B,B) = 1 + 0 = dist(A,B) ✓\n                            next router is B, so PHP pops 16004\nB       24005 16002         its own Adj-SID: pop, send on B→C (10)    16002\nC       16002               16002 is E’s: forward to E, 1 + 0 = 1 ✓   no labels\n                            next router is E, so PHP pops 16002\nE       no labels           deliver                                   –",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a07-text-48",
   "type": "text",
   "x": 18,
   "y": 827,
   "width": 601,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 380112,
   "version": 1,
   "versionNonce": 5026992,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Total 1 + 1 + 10 + 1 = 13: exactly the post-convergence cost of A5.",
   "originalText": "Total 1 + 1 + 10 + 1 = 13: exactly the post-convergence cost of A5.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
