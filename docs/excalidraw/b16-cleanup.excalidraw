  {
   "id": "b16-text-56",
   "type": "text",
   "x": 18,
   "y": 1111,
   "width": 1600,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A TI-LFA repair always leaves S on the first link of the post-convergence path, so a first segment that only gets to that first hop (a PrefixSID or an AdjSID) is wasted\nand dropped. That is why a repair whose first hop is already an LFA needs 0 extra labels.",
   "originalText": "A TI-LFA repair always leaves S on the first link of the post-convergence path, so a first segment that only gets to that first hop (a PrefixSID or an AdjSID) is wasted\nand dropped. That is why a repair whose first hop is already an LFA needs 0 extra labels.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
