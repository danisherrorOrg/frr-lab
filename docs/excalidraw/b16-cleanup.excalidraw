  },
  {
   "id": "b16-text-16",
   "type": "text",
   "x": 638,
   "y": 557,
   "width": 849,
   "height": 123,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 126704,
   "version": 1,
   "versionNonce": 1675664,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example        Row         Walk                             Dropped          Final\n-------------  ----------  -------------------------------  ---------------  ------------------------\n1  square      S → D       [P(N), P(D)]                     P(N)             [P(D)] = 16004\n3  ring, B–C   B → A       [Adj(B→C), P(A)]                 Adj(B→C)         [P(A)] = 16003\n4  ISP core    PE1 → P1    [P(P2), Adj(P2→P1)]              P(P2)            [Adj(P2→P1), P(P1)]\n5  leaf-spine  SP1 → L1    [P(L2), P(SP2), P(L1)]           P(L2)            [P(SP2), P(L1)]\n7  parallel    S → E       [Adj(S→E over S-E#2)]  (N = D)   Adj(S→E)         [P(E)] = 16002",
   "originalText": "Example        Row         Walk                             Dropped          Final\n-------------  ----------  -------------------------------  ---------------  ------------------------\n1  square      S → D       [P(N), P(D)]                     P(N)             [P(D)] = 16004\n3  ring, B–C   B → A       [Adj(B→C), P(A)]                 Adj(B→C)         [P(A)] = 16003\n4  ISP core    PE1 → P1    [P(P2), Adj(P2→P1)]              P(P2)            [Adj(P2→P1), P(P1)]\n5  leaf-spine  SP1 → L1    [P(L2), P(SP2), P(L1)]           P(L2)            [P(SP2), P(L1)]\n7  parallel    S → E       [Adj(S→E over S-E#2)]  (N = D)   Adj(S→E)         [P(E)] = 16002",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
