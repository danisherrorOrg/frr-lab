   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green: the post-convergence path B → C → E → S → A (13). Its\nfirst hop is C.",
   "originalText": "Green: the post-convergence path B → C → E → S → A (13). Its\nfirst hop is C.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
