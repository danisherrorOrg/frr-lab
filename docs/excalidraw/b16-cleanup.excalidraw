  },
  {
   "id": "b16-text-53",
   "type": "text",
   "x": 1125,
   "y": 860,
   "width": 496,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  Only the first segment is checked. Later Adj-SIDs\n   stay: they force a link the old tables wouldn’t\n   use.\n•  Parallel links (A10): \"out via E over S-E#2\"\n   names the exact link, so its Adj-SID can go too.\n•  Node mode (B19): the same rule.",
   "originalText": "•  Only the first segment is checked. Later Adj-SIDs\n   stay: they force a link the old tables wouldn’t\n   use.\n•  Parallel links (A10): \"out via E over S-E#2\"\n   names the exact link, so its Adj-SID can go too.\n•  Node mode (B19): the same rule.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
