   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b16-text-8",
   "type": "text",
   "x": 18,
   "y": 706,
   "width": 547,
   "height": 60,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 63352,
   "version": 1,
   "versionNonce": 837832,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Orange: the walk starts with AdjSID(B→C), since B’s old path\nto C is B → A → S → E → C (4). But the repair leaves B on the\nlink B–C anyway, so that label adds nothing: it is dropped.",
   "originalText": "Orange: the walk starts with AdjSID(B→C), since B’s old path\nto C is B → A → S → E → C (4). But the repair leaves B on the\nlink B–C anyway, so that label adds nothing: it is dropped.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
