   "roundness": null,
   "seed": 388031,
   "version": 1,
   "versionNonce": 5131721,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 1 would need [16003, 16004]: 1 extra label\nfor what is really a plain LFA (S → N → D). With the\nclean-up it is [16004], 0 extra labels, the same as\nthe LFA.",
   "originalText": "Example 1 would need [16003, 16004]: 1 extra label\nfor what is really a plain LFA (S → N → D). With the\nclean-up it is [16004], 0 extra labels, the same as\nthe LFA.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
