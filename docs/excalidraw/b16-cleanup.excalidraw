  },
  {
   "id": "b16-text-45",
   "type": "text",
   "x": 18,
   "y": 860,
   "width": 486,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 356355,
   "version": 1,
   "versionNonce": 4712805,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If N is D, could the walk start with PrefixSID(D)?\nNo: S–E is a primary link for D, so S’s old path to\nD uses it and check (b) fails. The walk gives\nAdjSID(S→D) instead, which is dropped, and B17 adds\nPrefixSID(D) back.",
   "originalText": "If N is D, could the walk start with PrefixSID(D)?\nNo: S–E is a primary link for D, so S’s old path to\nD uses it and check (b) fails. The walk gives\nAdjSID(S→D) instead, which is dropped, and B17 adds\nPrefixSID(D) back.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b16-text-46",
   "type": "text",
   "x": 18,
   "y": 977,
   "width": 440,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 7, S → E over the second link S-E#2 shows\nexactly that.",
   "originalText": "Example 7, S → E over the second link S-E#2 shows\nexactly that.",
   "fontSize": 16,
   "fontFamily": 2,
