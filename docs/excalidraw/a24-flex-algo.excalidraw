   "roundness": null,
   "seed": 348436,
   "version": 1,
   "versionNonce": 4608076,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Algorithm 128 exists to keep traffic on low-delay\nlinks and off red ones. A repair computed in\nalgorithm 0 could use exactly the link the operator\nwanted to avoid: S–E is red.",
   "originalText": "Algorithm 128 exists to keep traffic on low-delay\nlinks and off red ones. A repair computed in\nalgorithm 0 could use exactly the link the operator\nwanted to avoid: S–E is red.",
   "fontSize": 17,
