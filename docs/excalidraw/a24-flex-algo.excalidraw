   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D’s SID index is 5: 16000 + 5 in algorithm 0, 16000 + 1005 in 128.",
   "originalText": "D’s SID index is 5: 16000 + 5 in algorithm 0, 16000 + 1005 in 128.",
   "fontSize": 16,
