   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  SID indices are checked unique over all\n   algorithms: they share the SRGB.\n•  LANs keep only the IGP metric (no TE metric or\n   delay on them here).\n•  A Flex-Algo on the IGP metric with no rules gives\n   algorithm 0’s paths (a property test).",
   "originalText": "•  SID indices are checked unique over all\n   algorithms: they share the SRGB.\n•  LANs keep only the IGP metric (no TE metric or\n   delay on them here).\n•  A Flex-Algo on the IGP metric with no rules gives\n   algorithm 0’s paths (a property test).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
