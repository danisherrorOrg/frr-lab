   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A Flex-Algo is another SPF in the same network, with its own metric, its own link rules and its own Prefix-SIDs. Its FRR runs on that same restricted network. In\nExample 11, algorithm 128 drops the red link S–E, sends S → D via A, and repairs via B with label 17005.",
   "originalText": "A Flex-Algo is another SPF in the same network, with its own metric, its own link rules and its own Prefix-SIDs. Its FRR runs on that same restricted network. In\nExample 11, algorithm 128 drops the red link S–E, sends S → D via A, and repairs via B with label 17005.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
