  {
   "id": "a24-text-10",
   "type": "text",
   "x": 638,
   "y": 128,
   "width": 851,
   "height": 28,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
