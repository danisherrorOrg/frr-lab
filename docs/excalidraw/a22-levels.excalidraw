   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a22-text-5",
   "type": "text",
   "x": 18,
   "y": 596,
   "width": 529,
   "height": 40,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 39595,
   "version": 1,
   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Teal boxes: the areas. R1 and R5 are Level-1 only (dashed);\nR2, R3, R4 are Level-1-2.",
   "originalText": "Teal boxes: the areas. R1 and R5 are Level-1 only (dashed);\nR2, R3, R4 are Level-1-2.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a22-text-6",
   "type": "text",
   "x": 18,
   "y": 646,
   "width": 529,
   "height": 40,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Teal links: level 1 only. Purple: level 2 only. Black: both\nlevels (left out = both).",
   "originalText": "Teal links: level 1 only. Purple: level 2 only. Black: both\nlevels (left out = both).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
