  {
   "id": "a22-text-9",
   "type": "text",
   "x": 638,
   "y": 128,
   "width": 666,
   "height": 28,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
