   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Whole network, as one level\nLevel-2                 3 routers\nLevel-1, area 49.0001   3 routers\nLevel-1, area 49.0002   2 routers",
   "originalText": "Whole network, as one level\nLevel-2                 3 routers\nLevel-1, area 49.0001   3 routers\nLevel-1, area 49.0002   2 routers",
