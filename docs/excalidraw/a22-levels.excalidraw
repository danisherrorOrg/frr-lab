   "roundness": null,
   "seed": 403869,
   "version": 1,
   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Edits are merged back into the whole network\n(mergeLevel): routers and links the view showed are\nreplaced or removed, new ones are added, a LAN\nmember’s metric follows.",
   "originalText": "Edits are merged back into the whole network\n(mergeLevel): routers and links the view showed are\nreplaced or removed, new ones are added, a LAN\nmember’s metric follows.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a22-text-52",
   "type": "text",
   "x": 18,
   "y": 905,
   "width": 475,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Export and Share always write the whole network.\nSwitching level clears failures and the undo history.",
   "originalText": "Export and Share always write the whole network.\nSwitching level clears failures and the undo history.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
