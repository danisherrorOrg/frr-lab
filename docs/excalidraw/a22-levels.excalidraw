   "version": 1,
   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The sidebar’s IS-IS level picker appears only when\nthe network has levels or areas. Example 10 offers:",
   "originalText": "The sidebar’s IS-IS level picker appears only when\nthe network has levels or areas. Example 10 offers:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a22-text-59",
   "type": "text",
   "x": 1125,
   "y": 863,
   "width": 297,
   "height": 75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
