  },
  {
   "id": "a22-text-62",
   "type": "text",
   "x": 18,
   "y": 1053,
   "width": 1600,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 490978,
   "version": 1,
   "versionNonce": 6493198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "IS-IS runs a separate SPF and FRR per level, so LFA Lab cuts out one level (the Level-2 backbone, or one Level-1 area) and runs every tool on it unchanged. A link joins\na level only if both ends belong to it, and a LAN is dropped from a level where fewer than two of its members remain.",
   "originalText": "IS-IS runs a separate SPF and FRR per level, so LFA Lab cuts out one level (the Level-2 backbone, or one Level-1 area) and runs every tool on it unchanged. A link joins\na level only if both ends belong to it, and a LAN is dropped from a level where fewer than two of its members remain.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a22-text-63",
   "type": "text",
   "x": 0,
   "y": 1128,
   "width": 1524,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
