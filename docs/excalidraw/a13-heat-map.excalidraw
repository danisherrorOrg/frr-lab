   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A \"–\" link",
   "originalText": "A \"–\" link",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a13-text-56",
   "type": "text",
   "x": 1125,
   "y": 880,
   "width": 486,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A link on no shortest path is no pair’s primary\nlink, so it has 0 pairs. It is never \"unprotected\";\nit can only carry backup traffic.",
   "originalText": "A link on no shortest path is no pair’s primary\nlink, so it has 0 pairs. It is never \"unprotected\";\nit can only carry backup traffic.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a13-text-57",
   "type": "text",
   "x": 1125,
   "y": 954,
   "width": 279,
   "height": 38,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ex. 3, C–B (metric 10): 0 pairs\nEx. 7, S-E#2 (20 > 10): 0 pairs",
   "originalText": "Ex. 3, C–B (metric 10): 0 pairs\nEx. 7, S-E#2 (20 > 10): 0 pairs",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a13-text-58",
   "type": "text",
   "x": 1125,
   "y": 1002,
   "width": 440,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 459302,
   "version": 1,
   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A link’s pairs are the per-link view’s rows (A12)\ncounted.",
   "originalText": "A link’s pairs are the per-link view’s rows (A12)\ncounted.",
   "fontSize": 16,
   "fontFamily": 2,
