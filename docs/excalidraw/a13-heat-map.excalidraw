   "versionNonce": 1570935,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Router  Pairs  LFA        LFA + RLFA  TI-LFA      Link  Pairs  LFA        LFA + RLFA  TI-LFA\n------  -----  ---------  ----------  ----------  ----  -----  ---------  ----------  ----------\nS       4      0    0%    0    0%     4   100%    S–E   5      0    0%    0    0%     5   100%\nE       4      0    0%    0    0%     4   100%    A–S   5      0    0%    0    0%     5   100%\nA       4      0    0%    0    0%     4   100%    B–A   5      4   80%    4   80%     5   100%\nB       4      4  100%    4  100%     4   100%    E–C   5      4   80%    4   80%     5   100%\nC       4      4  100%    4  100%     4   100%    C–B   0      –          –           –\n------  -----                                     ----  -----\ntotal   20     8   40%    8   40%    20   100%    total 20     8   40%    8   40%    20   100%",
   "originalText": "Router  Pairs  LFA        LFA + RLFA  TI-LFA      Link  Pairs  LFA        LFA + RLFA  TI-LFA\n------  -----  ---------  ----------  ----------  ----  -----  ---------  ----------  ----------\nS       4      0    0%    0    0%     4   100%    S–E   5      0    0%    0    0%     5   100%\nE       4      0    0%    0    0%     4   100%    A–S   5      0    0%    0    0%     5   100%\nA       4      0    0%    0    0%     4   100%    B–A   5      4   80%    4   80%     5   100%\nB       4      4  100%    4  100%     4   100%    E–C   5      4   80%    4   80%     5   100%\nC       4      4  100%    4  100%     4   100%    C–B   0      –          –           –\n------  -----                                     ----  -----\ntotal   20     8   40%    8   40%    20   100%    total 20     8   40%    8   40%    20   100%",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
