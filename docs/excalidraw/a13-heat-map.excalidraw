   "text": "Where a link’s 5 pairs come from (FRR is local repair)",
   "originalText": "Where a link’s 5 pairs come from (FRR is local repair)",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
