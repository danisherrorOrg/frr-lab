   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "share in a mode = pairs protected in that mode / pairs\nmodes: LFA (ECMP counts as LFA) · LFA + Remote LFA · TI-LFA",
   "originalText": "share in a mode = pairs protected in that mode / pairs\nmodes: LFA (ECMP counts as LFA) · LFA + Remote LFA · TI-LFA",
