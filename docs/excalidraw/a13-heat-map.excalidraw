  {
   "id": "a13-text-61",
   "type": "text",
   "x": 18,
   "y": 1177,
   "width": 1590,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
