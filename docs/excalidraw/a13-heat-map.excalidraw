   "versionNonce": 1152019,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A pair = (destination D, primary link S–E), as in A8. coverageMap() runs computeForSource() for every\nrouter, then adds each pair to:",
   "originalText": "A pair = (destination D, primary link S–E), as in A8. coverageMap() runs computeForSource() for every\nrouter, then adds each pair to:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a13-text-12",
   "type": "text",
   "x": 638,
   "y": 219,
   "width": 667,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 95028,
   "version": 1,
   "versionNonce": 1256748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  the router R that repairs it (the PLR, R = S): R’s own coverage row\n•  the link it protects, S–E, with both directions added up",
   "originalText": "•  the router R that repairs it (the PLR, R = S): R’s own coverage row\n•  the link it protects, S–E, with both directions added up",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
