  },
  {
   "id": "a13-text-50",
   "type": "text",
   "x": 571,
   "y": 842,
   "width": 456,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
