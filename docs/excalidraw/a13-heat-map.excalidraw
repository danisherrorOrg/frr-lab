   "versionNonce": 1780393,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S–E:  S over S→E: E, C (2)     +  E over E→S: S, A, B (3)     = 5, no LFA\nB–A:  B over B→A: A, S, E, C (4, LFA C)  +  A over A→B: B (1, TI-LFA only)  = 4/5 LFA",
   "originalText": "S–E:  S over S→E: E, C (2)     +  E over E→S: S, A, B (3)     = 5, no LFA\nB–A:  B over B→A: A, S, E, C (4, LFA C)  +  A over A→B: B (1, TI-LFA only)  = 4/5 LFA",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
