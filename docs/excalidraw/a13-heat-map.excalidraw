   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 2 (C–B = 1): every router and every link 2/4 =\n50% LFA, 4/4 with Remote LFA.",
   "originalText": "Example 2 (C–B = 1): every router and every link 2/4 =\n50% LFA, 4/4 with Remote LFA.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
