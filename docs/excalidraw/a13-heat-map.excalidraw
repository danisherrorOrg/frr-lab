   "versionNonce": 5236450,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A router’s % is not \"what if R fails\"",
   "originalText": "A router’s % is not \"what if R fails\"",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a13-text-51",
   "type": "text",
   "x": 571,
   "y": 880,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 403869,
   "version": 1,
   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Router R’s number is link protection: \"if one of R’s\nown links fails, how much of R’s traffic has a\nbackup?\"",
   "originalText": "Router R’s number is link protection: \"if one of R’s\nown links fails, how much of R’s traffic has a\nbackup?\"",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a13-text-52",
   "type": "text",
   "x": 571,
   "y": 954,
   "width": 457,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Router B at 100% says nothing about what happens\nwhen B itself fails. For that, fail the router:\nWeakest spots (A18) or the simulation (A9).",
   "originalText": "Router B at 100% says nothing about what happens\nwhen B itself fails. For that, fail the router:\nWeakest spots (A18) or the simulation (A9).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a13-text-53",
   "type": "text",
   "x": 571,
   "y": 1028,
   "width": 404,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In node mode (A6) the counted backups are the\nnode-protecting ones where they exist.",
   "originalText": "In node mode (A6) the counted backups are the\nnode-protecting ones where they exist.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
