   "roundness": null,
   "seed": 483059,
   "version": 1,
   "versionNonce": 6388469,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The heat map shows where the gaps are: each router and link gets the share of its pairs that have a backup in the chosen repair mode. In Example 3 with LFA only, S, E,\nA and the links S–E and A–S are at 0%; only TI-LFA covers them.",
   "originalText": "The heat map shows where the gaps are: each router and link gets the share of its pairs that have a backup in the chosen repair mode. In Example 3 with LFA only, S, E,\nA and the links S–E and A–S are at 0%; only TI-LFA covers them.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
