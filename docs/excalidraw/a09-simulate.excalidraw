  {
   "id": "a09-text-9",
   "type": "text",
   "x": 638,
   "y": 128,
   "width": 555,
   "height": 28,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
