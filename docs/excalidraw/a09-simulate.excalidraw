   "versionNonce": 5131721,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Traffic to E, TI-LFA. S’s repair S → A → B → C → E\nmeets C–E down at C. C’s own backup for E goes back\nthrough B and A to S: the same packet as at the\nstart.",
   "originalText": "Traffic to E, TI-LFA. S’s repair S → A → B → C → E\nmeets C–E down at C. C’s own backup for E goes back\nthrough B and A to S: the same packet as at the\nstart.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a09-text-50",
   "type": "text",
