  {
   "id": "a09-text-15",
   "type": "text",
   "x": 638,
   "y": 643,
   "width": 962,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 118785,
   "version": 1,
   "versionNonce": 1570935,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each router only plans for its own link (RFC 9855 §1). With a router down, link-protecting TI-LFA can\ndo worse than plain LFA. With protection: node, TI-LFA delivers on S → N → M → D (A6).",
   "originalText": "Each router only plans for its own link (RFC 9855 §1). With a router down, link-protecting TI-LFA can\ndo worse than plain LFA. With protection: node, TI-LFA delivers on S → N → M → D (A6).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
