   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Hop-by-hop rules (several failures)",
   "originalText": "Hop-by-hop rules (several failures)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a09-text-62",
   "type": "text",
   "x": 571,
   "y": 1062,
   "width": 486,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 490978,
   "version": 1,
   "versionNonce": 6493198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A router holds one primary and one backup, so it\nrepairs at most once per visit. Backups are planned\non the full map.",
   "originalText": "A router holds one primary and one backup, so it\nrepairs at most once per visit. Backups are planned\non the full map.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a09-text-63",
   "type": "text",
   "x": 571,
   "y": 1136,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 498897,
   "version": 1,
   "versionNonce": 6597927,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Loop = the traffic comes back to a router carrying\nthe same thing as before. After 255 hops (IP TTL) it\nis cut.",
   "originalText": "Loop = the traffic comes back to a router carrying\nthe same thing as before. After 255 hops (IP TTL) it\nis cut.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
