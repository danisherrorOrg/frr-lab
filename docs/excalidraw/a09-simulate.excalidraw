   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S’s backup S → A → D meets A–D down at A. A’s own\nbackup A → B → D avoids both.",
   "originalText": "S’s backup S → A → D meets A–D down at A. A’s own\nbackup A → B → D avoids both.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
