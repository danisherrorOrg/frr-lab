  {
   "id": "a09-text-66",
   "type": "text",
   "x": 1125,
   "y": 1062,
   "width": 429,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 522654,
   "version": 1,
   "versionNonce": 6912114,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "simulateAllSources() runs it once per router.\nExample 6, router E down, LFA only:",
   "originalText": "simulateAllSources() runs it once per router.\nExample 6, router E down, LFA only:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a09-text-67",
   "type": "text",
   "x": 1125,
   "y": 1115,
   "width": 288,
   "height": 75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 530573,
   "version": 1,
   "versionNonce": 7016843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S: 1 affected, repaired, relayed\nN: D via LFA M, survives\nD: S, N via LFA M, survive\nM: nothing affected",
   "originalText": "S: 1 affected, repaired, relayed\nN: D via LFA M, survives\nD: S, N via LFA M, survive\nM: nothing affected",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
