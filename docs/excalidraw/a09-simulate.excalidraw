  },
  {
   "id": "a09-text-70",
   "type": "text",
   "x": 18,
   "y": 1294,
   "width": 1581,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 554330,
   "version": 1,
   "versionNonce": 7331030,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FRR plans for one failure. The simulation shows what really happens when more fails: the PLR uses its backup, any router whose own link is down repairs again, and the\ntraffic ends delivered, dropped or looping. Link-protecting backups can break when a whole router fails.",
   "originalText": "FRR plans for one failure. The simulation shows what really happens when more fails: the PLR uses its backup, any router whose own link is down repairs again, and the\ntraffic ends delivered, dropped or looping. Link-protecting backups can break when a whole router fails.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
