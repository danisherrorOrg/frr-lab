   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green arrows, LFA only: S repairs to N, N repairs again to M.\nDelivered on S → N → M → D, cost 1 + 10 + 10 = 21.",
   "originalText": "Green arrows, LFA only: S repairs to N, N repairs again to M.\nDelivered on S → N → M → D, cost 1 + 10 + 10 = 21.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
