  {
   "id": "a09-text-49",
   "type": "text",
   "x": 571,
   "y": 790,
   "width": 486,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
