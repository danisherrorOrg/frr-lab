   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S–E 10, E–D 10, S–A 10, A–D 15, A–B 10, B–D 10. Fail\nS–E and A–D, TI-LFA.",
   "originalText": "S–E 10, E–D 10, S–A 10, A–D 15, A–B 10, B–D 10. Fail\nS–E and A–D, TI-LFA.",
   "fontSize": 17,
