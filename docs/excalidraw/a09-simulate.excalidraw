  {
   "id": "a09-text-59",
   "type": "text",
   "x": 18,
   "y": 1062,
   "width": 467,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  D = E: unreachable, expected\n•  not affected: the normal path avoids E\n•  survives: the PLR’s planned backup avoids E\n•  broken: the planned backup goes through E; the\n   panel names the router just before E and why\n•  no backup: dropped at the PLR",
   "originalText": "•  D = E: unreachable, expected\n•  not affected: the normal path avoids E\n•  survives: the PLR’s planned backup avoids E\n•  broken: the planned backup goes through E; the\n   panel names the router just before E and why\n•  no backup: dropped at the PLR",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
