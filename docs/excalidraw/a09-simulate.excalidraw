   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "E has lost both its links, so its status is\nunreachable. C survives: S → A → B → C avoids E–C.",
   "originalText": "E has lost both its links, so its status is\nunreachable. C survives: S → A → B → C avoids E–C.",
