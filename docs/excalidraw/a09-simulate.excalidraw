  {
   "id": "a09-text-54",
   "type": "text",
   "x": 1125,
   "y": 790,
   "width": 496,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
