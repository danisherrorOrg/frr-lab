   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green: the default policy. N picks M (node-protecting), so it\nreaches D on S → N → M → D (21).",
   "originalText": "Green: the default policy. N picks M (node-protecting), so it\nreaches D on S → N → M → D (21).",
