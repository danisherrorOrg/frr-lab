   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b04-text-57",
   "type": "text",
   "x": 18,
   "y": 1111,
   "width": 1562,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A downstream neighbor is strictly closer to D, so traffic only ever moves \"downhill\" towards D. Two routers repairing at the same time can’t bounce it between them.\nLoop-free alone can: in Example 6, S and N are each other’s LFA and loop when router E fails.",
   "originalText": "A downstream neighbor is strictly closer to D, so traffic only ever moves \"downhill\" towards D. Two routers repairing at the same time can’t bounce it between them.\nLoop-free alone can: in Example 6, S and N are each other’s LFA and loop when router E fails.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b04-text-58",
   "type": "text",
   "x": 0,
   "y": 1186,
   "width": 1542,
