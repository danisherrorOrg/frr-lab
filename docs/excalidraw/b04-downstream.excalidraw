  },
  {
   "id": "b04-text-47",
   "type": "text",
   "x": 18,
   "y": 900,
   "width": 493,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
