   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "lfa_policy:\n  downstream: prefer | require | ignore",
   "originalText": "lfa_policy:\n  downstream: prefer | require | ignore",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b04-text-51",
   "type": "text",
   "x": 571,
   "y": 895,
   "width": 486,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 403869,
   "version": 1,
   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  prefer (default): step 2 of B7.\n•  require: a non-downstream candidate is shown but\n   never chosen (not-downstream).\n•  ignore: step 2 is skipped.",
   "originalText": "•  prefer (default): step 2 of B7.\n•  require: a non-downstream candidate is shown but\n   never chosen (not-downstream).\n•  ignore: step 2 is skipped.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
