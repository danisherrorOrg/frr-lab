   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red double arrow: with node_protecting: ignore, S’s LFA is N\nand N’s LFA is S. Each sends D’s traffic to the other.",
   "originalText": "Red double arrow: with node_protecting: ignore, S’s LFA is N\nand N’s LFA is S. Each sends D’s traffic to the other.",
