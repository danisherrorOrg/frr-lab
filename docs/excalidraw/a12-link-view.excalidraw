   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A link on no shortest path carries no traffic either\nway. It can only ever be a backup.",
   "originalText": "A link on no shortest path carries no traffic either\nway. It can only ever be a backup.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
