   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "pairs        35 → 31\nLFA          27 → 13\nLFA + RLFA   35 → 15\nTI-LFA       35 → 21",
