   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a14-text-67",
   "type": "text",
   "x": 18,
   "y": 1147,
   "width": 1571,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 530573,
   "version": 1,
   "versionNonce": 7016843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The what-if diff runs the coverage report on the network before and after one change, and lists every source and destination whose protection got better or worse. In\nExample 3, one metric change (C–B 10 → 1) lets Remote LFA cover the whole ring, but 4 destinations lose their LFA.",
   "originalText": "The what-if diff runs the coverage report on the network before and after one change, and lists every source and destination whose protection got better or worse. In\nExample 3, one metric change (C–B 10 → 1) lets Remote LFA cover the whole ring, but 4 destinations lose their LFA.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
