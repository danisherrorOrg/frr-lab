  },
  {
   "id": "a14-text-19",
   "type": "text",
   "x": 638,
   "y": 548,
   "width": 756,
   "height": 113,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
