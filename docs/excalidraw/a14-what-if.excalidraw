   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Worked: 12 better, 4 worse, 2 rerouted",
   "originalText": "Worked: 12 better, 4 worse, 2 rerouted",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
