   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What it doesn’t do",
   "originalText": "What it doesn’t do",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a14-text-63",
   "type": "text",
   "x": 1125,
   "y": 890,
   "width": 486,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 498897,
   "version": 1,
   "versionNonce": 6597927,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  It compares the plan on the full network, like\n   the coverage report. Links and routers failed in\n   the simulation are not taken out.\n•  A D with no pairs on one side (unreachable) is\n   \"rerouted\". A metric change never causes this.",
   "originalText": "•  It compares the plan on the full network, like\n   the coverage report. Links and routers failed in\n   the simulation are not taken out.\n•  A D with no pairs on one side (unreachable) is\n   \"rerouted\". A metric change never causes this.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a14-text-64",
   "type": "text",
   "x": 1125,
   "y": 1007,
   "width": 493,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 506816,
   "version": 1,
   "versionNonce": 6702656,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Swapping before and after swaps \"better\" and \"worse\" (a\nproperty test).",
   "originalText": "Swapping before and after swaps \"better\" and \"worse\" (a\nproperty test).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
