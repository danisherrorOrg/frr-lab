   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Worse: B→A, B→C, C→B, C→E. Rerouted: B→E, C→A. The other 12 are better.",
   "originalText": "Worse: B→A, B→C, C→B, C→E. Rerouted: B→E, C→A. The other 12 are better.",
