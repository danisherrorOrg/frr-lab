   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "LFA          8/20 = 40%  →  10/20 =  50%   (+10 points)\nLFA + RLFA   8/20 = 40%  →  20/20 = 100%   (+60 points)\nTI-LFA      20/20 = 100% → 20/20 = 100%   (no change)",
   "originalText": "LFA          8/20 = 40%  →  10/20 =  50%   (+10 points)\nLFA + RLFA   8/20 = 40%  →  20/20 = 100%   (+60 points)\nTI-LFA      20/20 = 100% → 20/20 = 100%   (no change)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
