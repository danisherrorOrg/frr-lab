   "roundness": null,
   "seed": 63352,
   "version": 1,
   "versionNonce": 837832,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Result: no LFA, no PQ node, no TI-LFA. D is cut off.",
