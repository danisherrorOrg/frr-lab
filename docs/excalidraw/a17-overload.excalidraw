  {
   "id": "a17-text-46",
   "type": "text",
   "x": 571,
   "y": 800,
   "width": 324,
   "height": 150,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ex. 2, B overloaded:\n  dist(A,C) = 3 (A-S-E-C), not A-B-C\n  B still reached: dist(S,B) = 2\nEx. 2, C overloaded, S → E:\n  ext. P = {A, B, C}, Q(E) = {C}\n  C overloaded → no PQ node\nEx. 4, P1 overloaded (what-if, A14):\n  pairs 35 → 31, TI-LFA 35 → 21",
   "originalText": "Ex. 2, B overloaded:\n  dist(A,C) = 3 (A-S-E-C), not A-B-C\n  B still reached: dist(S,B) = 2\nEx. 2, C overloaded, S → E:\n  ext. P = {A, B, C}, Q(E) = {C}\n  C overloaded → no PQ node\nEx. 4, P1 overloaded (what-if, A14):\n  pairs 35 → 31, TI-LFA 35 → 21",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
