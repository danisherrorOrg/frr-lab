   "versionNonce": 5026992,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What stays the same",
   "originalText": "What stays the same",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a17-text-49",
   "type": "text",
   "x": 1125,
   "y": 800,
   "width": 496,
   "height": 149,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 388031,
   "version": 1,
   "versionNonce": 5131721,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  An overloaded router is still a destination, and\n   it still forwards its own traffic (it is the root\n   of its own SPF).\n•  ECMP: unchanged. It is only a primary next hop\n   for its own address.\n•  Failure simulation (A9): nothing new; every table\n   follows the rules above.",
   "originalText": "•  An overloaded router is still a destination, and\n   it still forwards its own traffic (it is the root\n   of its own SPF).\n•  ECMP: unchanged. It is only a primary next hop\n   for its own address.\n•  Failure simulation (A9): nothing new; every table\n   follows the rules above.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a17-text-50",
   "type": "text",
   "x": 1125,
   "y": 959,
   "width": 341,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 395950,
   "version": 1,
   "versionNonce": 5236450,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In YAML: overload: true on the router.",
   "originalText": "In YAML: overload: true on the router.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
