  {
   "id": "a17-text-41",
   "type": "text",
   "x": 18,
   "y": 800,
   "width": 486,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 324679,
   "version": 1,
   "versionNonce": 4293889,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kite: N–S 1, S–E 1, E–D 1, N–D 10. S is overloaded;\nS → D.",
   "originalText": "Kite: N–S 1, S–E 1, E–D 1, N–D 10. S is overloaded;\nS → D.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a17-text-42",
   "type": "text",
   "x": 18,
   "y": 853,
   "width": 378,
   "height": 113,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 332598,
   "version": 1,
   "versionNonce": 4398618,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "no bit:  dist(N,D) = 3 (N-S-E-D)\n         3 < 1+2         ✗ not loop-free\nS bit:   dist(N,D) = 10\n         10 < ∞          ✓ loop-free\n         10 < 11+1 = 12  ✓ node-protecting\n         10 < 2          ✗ not downstream",
   "originalText": "no bit:  dist(N,D) = 3 (N-S-E-D)\n         3 < 1+2         ✗ not loop-free\nS bit:   dist(N,D) = 10\n         10 < ∞          ✓ loop-free\n         10 < 11+1 = 12  ✓ node-protecting\n         10 < 2          ✗ not downstream",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a17-text-43",
   "type": "text",
   "x": 18,
   "y": 976,
   "width": 466,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 340517,
   "version": 1,
   "versionNonce": 4503347,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "N never sends traffic back through S. TI-LFA: S-N-D,\n[PrefixSID(D)] = 16004.",
   "originalText": "N never sends traffic back through S. TI-LFA: S-N-D,\n[PrefixSID(D)] = 16004.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
