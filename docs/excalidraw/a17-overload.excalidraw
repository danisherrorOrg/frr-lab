   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Gray dashed: N has the overload bit. S–N–D is the only other\npath, and it passes through N.",
   "originalText": "Gray dashed: N has the overload bit. S–N–D is the only other\npath, and it passes through N.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
