   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a17-text-53",
   "type": "text",
   "x": 18,
   "y": 1110,
   "width": 1552,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A router with the overload bit can be reached but is never passed through, so it is never an LFA, a PQ node or a hop inside a TI-LFA path. Any check that adds up a\n\"path through\" it counts that path as ∞. That can remove backups (Example 1) or create one (the kite).",
   "originalText": "A router with the overload bit can be reached but is never passed through, so it is never an LFA, a PQ node or a hop inside a TI-LFA path. Any check that adds up a\n\"path through\" it counts that path as ∞. That can remove backups (Example 1) or create one (the kite).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
