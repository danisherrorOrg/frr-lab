   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Does a path use S→E? (§1.5, B1)",
   "originalText": "Does a path use S→E? (§1.5, B1)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-57",
   "type": "text",
   "x": 18,
   "y": 1133,
   "width": 404,
   "height": 20,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "dist(X,Y) < dist(X,S) + c(S,E) + dist(E,Y)",
   "originalText": "dist(X,Y) < dist(X,S) + c(S,E) + dist(E,Y)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-58",
   "type": "text",
   "x": 18,
   "y": 1163,
   "width": 448,
   "height": 22,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 459302,
   "version": 1,
   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Right side = the cheapest path forced over S→E.",
   "originalText": "Right side = the cheapest path forced over S→E.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-59",
   "type": "text",
   "x": 18,
   "y": 1195,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Strictly less: every shortest path avoids the link. \nEqual: an ECMP path may use it, so treat it as \"uses\nthe link\" (the safe choice).",
   "originalText": "Strictly less: every shortest path avoids the link. \nEqual: an ECMP path may use it, so treat it as \"uses\nthe link\" (the safe choice).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
