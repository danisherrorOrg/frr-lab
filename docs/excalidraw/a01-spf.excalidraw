   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Run one SPF per router: dist(X,Y) for every pair.\nFine for ≤ 200 routers, cached per topology version.",
   "originalText": "Run one SPF per router: dist(X,Y) for every pair.\nFine for ≤ 200 routers, cached per topology version.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-41",
   "type": "text",
   "x": 18,
   "y": 846,
   "width": 286,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
