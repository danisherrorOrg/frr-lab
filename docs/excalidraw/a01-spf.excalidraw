   "versionNonce": 5236450,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Reverse SPF (§1.2)",
   "originalText": "Reverse SPF (§1.2)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-51",
   "type": "text",
   "x": 1125,
   "y": 793,
   "width": 467,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 403869,
   "version": 1,
   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Dijkstra on the map with every link turned around\ngives dist(Y,R) for all Y: distances TOWARDS R.",
   "originalText": "Dijkstra on the map with every link turned around\ngives dist(Y,R) for all Y: distances TOWARDS R.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-52",
   "type": "text",
   "x": 1125,
   "y": 846,
   "width": 457,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Metrics may differ per direction, so dist(X,Y) ≠\ndist(Y,X) in general.",
   "originalText": "Metrics may differ per direction, so dist(X,Y) ≠\ndist(Y,X) in general.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-53",
   "type": "text",
   "x": 1125,
   "y": 899,
   "width": 486,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Used by Remote LFA's Q-space, which needs dist(Y,E)\nfor every Y: a reverse SPF rooted at E.",
   "originalText": "Used by Remote LFA's Q-space, which needs dist(Y,E)\nfor every Y: a reverse SPF rooted at E.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-54",
   "type": "text",
   "x": 1125,
   "y": 952,
   "width": 493,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 427626,
   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 1 is symmetric, so forward and reverse give the\nsame numbers.",
   "originalText": "Example 1 is symmetric, so forward and reverse give the\nsame numbers.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
