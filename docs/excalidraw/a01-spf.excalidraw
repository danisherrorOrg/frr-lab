   "versionNonce": 6388469,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ties: one path to draw",
   "originalText": "Ties: one path to draw",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-62",
   "type": "text",
   "x": 571,
   "y": 1133,
   "width": 486,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 490978,
   "version": 1,
   "versionNonce": 6493198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "When paths tie, the drawings and the failure\nsimulation take the neighbor with the lowest router\nid at each hop (alphabetical).",
   "originalText": "When paths tie, the drawings and the failure\nsimulation take the neighbor with the lowest router\nid at each hop (alphabetical).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a01-text-63",
   "type": "text",
   "x": 571,
   "y": 1207,
   "width": 466,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 498897,
   "version": 1,
   "versionNonce": 6597927,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It changes no protection result; it only makes every\ndrawing the same each time.",
   "originalText": "It changes no protection result; it only makes every\ndrawing the same each time.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
