   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "a01-text-56",
   "type": "text",
   "x": 18,
   "y": 1095,
   "width": 382,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
