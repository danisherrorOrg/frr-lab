   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 380112,
   "version": 1,
   "versionNonce": 5026992,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If one next hop's link fails, another primary next\nhop that doesn't use that link keeps carrying the\ntraffic. Nothing to pre-compute.",
   "originalText": "If one next hop's link fails, another primary next\nhop that doesn't use that link keeps carrying the\ntraffic. Nothing to pre-compute.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
