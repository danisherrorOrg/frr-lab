   "version": 1,
   "versionNonce": 4398618,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Read as dist(row, column). dist(N,E) = 20: N→D→E\n(10+10) beats N→S→E (15+10).",
   "originalText": "Read as dist(row, column). dist(N,E) = 20: N→D→E\n(10+10) beats N→S→E (15+10).",
