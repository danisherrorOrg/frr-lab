   "versionNonce": 4293889,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "from \\ to   S    E    N    D\nS           0   10   15   20\nE          10    0   20   10\nN          15   20    0   10\nD          20   10   10    0",
   "originalText": "from \\ to   S    E    N    D\nS           0   10   15   20\nE          10    0   20   10\nN          15   20    0   10\nD          20   10   10    0",
