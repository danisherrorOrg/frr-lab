   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b14-text-56",
   "type": "text",
   "x": 18,
   "y": 1026,
   "width": 1600,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TI-LFA’s backup is the path S will use anyway once the network has reconverged: SPF with the failed link (or router) removed. When paths tie, the lowest router ids win,\nso in Example 5 SP1 goes via L2, not L3 or L4. If no such path exists, the network is split and D can’t be protected.",
   "originalText": "TI-LFA’s backup is the path S will use anyway once the network has reconverged: SPF with the failed link (or router) removed. When paths tie, the lowest router ids win,\nso in Example 5 SP1 goes via L2, not L3 or L4. If no such path exists, the network is split and D can’t be protected.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
