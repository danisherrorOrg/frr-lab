   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "source  pairs  LFA  LFA/RLFA  TI-LFA\n------  -----  ---  --------  ------\nA       4      0    0         4\nB       4      4    4         4\nC       4      4    4         4\nE       4      0    0         4\nS       4      0    0         4\n------  -----  ---  --------  ------\nall     20     8    8         20\n               40%  40%       100%",
   "originalText": "source  pairs  LFA  LFA/RLFA  TI-LFA\n------  -----  ---  --------  ------\nA       4      0    0         4\nB       4      4    4         4\nC       4      4    4         4\nE       4      0    0         4\nS       4      0    0         4\n------  -----  ---  --------  ------\nall     20     8    8         20\n               40%  40%       100%",
