   "frameId": null,
   "roundness": null,
   "seed": 427626,
   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every pair LFA doesn’t protect, with the reason from\nthe strongest method that fails:",
   "originalText": "Every pair LFA doesn’t protect, with the reason from\nthe strongest method that fails:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-55",
   "type": "text",
   "x": 571,
   "y": 863,
   "width": 496,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  no-lfa: Remote LFA or TI-LFA saves it\n•  no-rlfa: only TI-LFA saves it\n•  too-deep: only TI-LFA, but deeper than S’s Max\n   SID depth (A15)\n•  partitioned: nothing; the link is the only way to\n   D",
   "originalText": "•  no-lfa: Remote LFA or TI-LFA saves it\n•  no-rlfa: only TI-LFA saves it\n•  too-deep: only TI-LFA, but deeper than S’s Max\n   SID depth (A15)\n•  partitioned: nothing; the link is the only way to\n   D",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-56",
   "type": "text",
   "x": 571,
   "y": 1001,
   "width": 252,
   "height": 57,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ex. 2: 10 pairs, all no-lfa\nEx. 3: 12 pairs, all no-rlfa\n       e.g. S → E over S–E",
   "originalText": "Ex. 2: 10 pairs, all no-lfa\nEx. 3: 12 pairs, all no-rlfa\n       e.g. S → E over S–E",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
