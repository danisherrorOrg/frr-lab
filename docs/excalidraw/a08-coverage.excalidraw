   "versionNonce": 7121572,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "With protection: node, also count the pairs with D ≠\nE, and of those the ones whose backups avoid router\nE.",
   "originalText": "With protection: node, also count the pairs with D ≠\nE, and of those the ones whose backups avoid router\nE.",
   "fontSize": 17,
