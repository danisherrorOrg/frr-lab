   "versionNonce": 1570935,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every router as the source (\"all sources\")",
   "originalText": "Every router as the source (\"all sources\")",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-16",
   "type": "text",
   "x": 638,
   "y": 540,
   "width": 981,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 126704,
   "version": 1,
   "versionNonce": 1675664,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Run the same count for every router and add them up. The ring is symmetric, so every router has 4 pairs\nand 2 LFAs:",
   "originalText": "Run the same count for every router and add them up. The ring is symmetric, so every router has 4 pairs\nand 2 LFAs:",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-17",
   "type": "text",
   "x": 638,
   "y": 593,
   "width": 807,
   "height": 20,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
