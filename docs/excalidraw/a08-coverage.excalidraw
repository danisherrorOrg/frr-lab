   "versionNonce": 6807385,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ECMP-protected pairs are counted on their own, and\nalso as LFA: the other next hop is always a\ndownstream LFA (B2).",
   "originalText": "ECMP-protected pairs are counted on their own, and\nalso as LFA: the other next hop is always a\ndownstream LFA (B2).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
