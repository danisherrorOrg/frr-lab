   "versionNonce": 1047290,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A pair = (destination D, primary next-hop link S–E)",
   "originalText": "A pair = (destination D, primary next-hop link S–E)",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-11",
   "type": "text",
   "x": 638,
   "y": 200,
   "width": 829,
   "height": 22,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 87109,
   "version": 1,
   "versionNonce": 1152019,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A destination with two ECMP next hops gives two pairs. Routers S can’t reach give none.",
   "originalText": "A destination with two ECMP next hops gives two pairs. Routers S can’t reach give none.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-12",
   "type": "text",
   "x": 638,
   "y": 232,
   "width": 634,
   "height": 60,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 95028,
   "version": 1,
   "versionNonce": 1256748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "LFA coverage    = pairs protected by LFA (or ECMP)   / all pairs\nRLFA coverage   = pairs protected by LFA or Remote LFA / all pairs\nTI-LFA coverage = pairs protected by TI-LFA            / all pairs",
   "originalText": "LFA coverage    = pairs protected by LFA (or ECMP)   / all pairs\nRLFA coverage   = pairs protected by LFA or Remote LFA / all pairs\nTI-LFA coverage = pairs protected by TI-LFA            / all pairs",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-13",
   "type": "text",
   "x": 638,
   "y": 302,
   "width": 203,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 102947,
   "version": 1,
   "versionNonce": 1361477,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 2, source S",
   "originalText": "Example 2, source S",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-14",
   "type": "text",
   "x": 638,
   "y": 336,
   "width": 644,
   "height": 160,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 110866,
   "version": 1,
   "versionNonce": 1466206,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "D   link  LFA         Remote LFA   TI-LFA              counted as\n--  ----  ----------  -----------  ------------------  ----------\nA   S–A   none        PQ C         ✓                   Remote LFA\nB   S–A   E           (not run)    ✓                   LFA\nC   S–E   A           (not run)    ✓                   LFA\nE   S–E   none        PQ B         [16004, 16002]      Remote LFA\n\nS:   LFA 2/4 = 50%     LFA or RLFA 4/4 = 100%     TI-LFA 4/4 = 100%",
   "originalText": "D   link  LFA         Remote LFA   TI-LFA              counted as\n--  ----  ----------  -----------  ------------------  ----------\nA   S–A   none        PQ C         ✓                   Remote LFA\nB   S–A   E           (not run)    ✓                   LFA\nC   S–E   A           (not run)    ✓                   LFA\nE   S–E   none        PQ B         [16004, 16002]      Remote LFA\n\nS:   LFA 2/4 = 50%     LFA or RLFA 4/4 = 100%     TI-LFA 4/4 = 100%",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a08-text-15",
   "type": "text",
   "x": 638,
   "y": 506,
   "width": 447,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
