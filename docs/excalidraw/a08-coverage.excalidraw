   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Remote LFA only runs when there is no LFA (B13), so \"RLFA coverage\" always includes the LFA pairs.",
   "originalText": "Remote LFA only runs when there is no LFA (B13), so \"RLFA coverage\" always includes the LFA pairs.",
