   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "all:  20 pairs    LFA 10/20 = 50%    LFA or RLFA 20/20 = 100%    TI-LFA 20/20 = 100%",
   "originalText": "all:  20 pairs    LFA 10/20 = 50%    LFA or RLFA 20/20 = 100%    TI-LFA 20/20 = 100%",
