  {
   "id": "b10-text-6",
   "type": "text",
   "x": 18,
   "y": 606,
   "width": 547,
   "height": 40,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Purple arrows: shortest paths towards E. P3 → P1 and PE2 → P3\n→ P1 avoid PE1–P1: Q(P1) = {P3, PE2}.",
   "originalText": "Purple arrows: shortest paths towards E. P3 → P1 and PE2 → P3\n→ P1 avoid PE1–P1: Q(P1) = {P3, PE2}.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b10-text-7",
   "type": "text",
   "x": 18,
   "y": 656,
   "width": 556,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Gray: P2 and P4 tie. Their shortest path to P1 (for P4, one of\ntwo) ends PE1 → P1.",
   "originalText": "Gray: P2 and P4 tie. Their shortest path to P1 (for P4, one of\ntwo) ends PE1 → P1.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b10-text-8",
   "type": "text",
   "x": 18,
   "y": 706,
   "width": 556,
   "height": 40,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 63352,
   "version": 1,
   "versionNonce": 837832,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Diagonal: P1 → P4 is 20, but P4 → P1 is 40. Q-space only looks\ntowards P1.",
   "originalText": "Diagonal: P1 → P4 is 20, but P4 → P1 is 40. Q-space only looks\ntowards P1.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
