   "versionNonce": 1989851,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example        Link   Q(E)        Out on a tie\n-------------  -----  ----------  ----------------------------\n2  ring        S–E    {B, C}      A: 2 = 1 + 1\n3  ring, B–C   S–E    {C}         A: 2 = 1 + 1,  B: 3 = 2 + 1\n8              S–E    {B, C, D}   N: 4 = 2 + 2",
   "originalText": "Example        Link   Q(E)        Out on a tie\n-------------  -----  ----------  ----------------------------\n2  ring        S–E    {B, C}      A: 2 = 1 + 1\n3  ring, B–C   S–E    {C}         A: 2 = 1 + 1,  B: 3 = 2 + 1\n8              S–E    {B, C, D}   N: 4 = 2 + 2",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
