   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The wrong direction gives the wrong answer",
   "originalText": "The wrong direction gives the wrong answer",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b10-text-17",
   "type": "text",
   "x": 638,
   "y": 537,
   "width": 756,
   "height": 38,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 134623,
   "version": 1,
   "versionNonce": 1780393,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "P4 with dist(P1,P4) = 20 (from E):   20 < 30  ✓   wrong, P4 would join Q\nP4 with dist(P4,P1) = 30 (to E):     30 < 30  ✗   right: 40 direct, 30 via P2 or PE2",
   "originalText": "P4 with dist(P1,P4) = 20 (from E):   20 < 30  ✓   wrong, P4 would join Q\nP4 with dist(P4,P1) = 30 (to E):     30 < 30  ✗   right: 40 direct, 30 via P2 or PE2",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
