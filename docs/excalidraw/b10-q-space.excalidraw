   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Q(P1) for link PE1–P1 = {P3, PE2}",
   "originalText": "Q(P1) for link PE1–P1 = {P3, PE2}",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b10-text-16",
   "type": "text",
   "x": 638,
   "y": 503,
   "width": 447,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
