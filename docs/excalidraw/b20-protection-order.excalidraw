  {
   "id": "b20-text-61",
   "type": "text",
   "x": 638,
   "y": 294,
   "width": 597,
   "height": 19,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
