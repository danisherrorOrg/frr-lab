  },
  {
   "id": "b20-text-63",
   "type": "text",
   "x": 18,
   "y": 636,
   "width": 678,
   "height": 28,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 498897,
   "version": 1,
   "versionNonce": 6597927,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every example, every router as source (from the engine)",
   "originalText": "Every example, every router as source (from the engine)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b20-text-64",
   "type": "text",
   "x": 18,
   "y": 674,
   "width": 567,
   "height": 244,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 506816,
   "version": 1,
   "versionNonce": 6702656,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example              Pairs  ECMP  LFA  Remote LFA  TI-LFA  None\n-------------------  -----  ----  ---  ----------  ------  ----\n 1  square              12     0    8           4       0     0\n 2  ring                20     0   10          10       0     0\n 3  ring, B–C = 10      20     0    8           0      12     0\n 4  ISP core            35    10   17           8       0     0\n 5  leaf-spine          48    32    0          16       0     0\n 6  link-protecting     22     4   14           4       0     0\n 7  parallel            16     8    7           1       0     0\n 8  node protection     33     6   18           9       0     0\n 9  SRLG                32     4   16          12       0     0\n10  LAN + levels        23     4   14           0       0     5\n11  Flex-Algo           24     8   10           5       1     0",
   "originalText": "Example              Pairs  ECMP  LFA  Remote LFA  TI-LFA  None\n-------------------  -----  ----  ---  ----------  ------  ----\n 1  square              12     0    8           4       0     0\n 2  ring                20     0   10          10       0     0\n 3  ring, B–C = 10      20     0    8           0      12     0\n 4  ISP core            35    10   17           8       0     0\n 5  leaf-spine          48    32    0          16       0     0\n 6  link-protecting     22     4   14           4       0     0\n 7  parallel            16     8    7           1       0     0\n 8  node protection     33     6   18           9       0     0\n 9  SRLG                32     4   16          12       0     0\n10  LAN + levels        23     4   14           0       0     5\n11  Flex-Algo           24     8   10           5       1     0",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b20-text-65",
   "type": "text",
   "x": 18,
   "y": 928,
   "width": 834,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 514735,
   "version": 1,
   "versionNonce": 6807385,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each row adds up to its pairs. The coverage numbers (A8) are running totals of these columns:\nLFA coverage = (ECMP + LFA) / pairs, so Example 4 has 27 / 35.",
   "originalText": "Each row adds up to its pairs. The coverage numbers (A8) are running totals of these columns:\nLFA coverage = (ECMP + LFA) / pairs, so Example 4 has 27 / 35.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b20-rectangle-66",
   "type": "rectangle",
   "x": 920,
   "y": 618,
   "width": 720,
   "height": 368,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "#f3f0ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 522654,
   "version": 1,
   "versionNonce": 6912114,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "b20-text-67",
   "type": "text",
   "x": 938,
   "y": 636,
   "width": 222,
   "height": 28,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 530573,
   "version": 1,
   "versionNonce": 7016843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why simplest first",
   "originalText": "Why simplest first",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b20-text-68",
   "type": "text",
   "x": 938,
   "y": 674,
   "width": 667,
   "height": 192,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 538492,
   "version": 1,
   "versionNonce": 7121572,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  ECMP: nothing to add. The router already has a second path and just\n   stops using the failed one.\n•  LFA: one more next hop in the table. No tunnel, no labels.\n•  Remote LFA: a tunnel to the PQ node.\n•  TI-LFA: a label stack built from the post-convergence path.\n\nCrediting each pair once to the simplest working method shows how much\nprotection each extra feature really buys. In Example 4, Remote LFA\ncloses the last 8 of 35 pairs; TI-LFA adds nothing new.",
   "originalText": "•  ECMP: nothing to add. The router already has a second path and just\n   stops using the failed one.\n•  LFA: one more next hop in the table. No tunnel, no labels.\n•  Remote LFA: a tunnel to the PQ node.\n•  TI-LFA: a label stack built from the post-convergence path.\n\nCrediting each pair once to the simplest working method shows how much\nprotection each extra feature really buys. In Example 4, Remote LFA\ncloses the last 8 of 35 pairs; TI-LFA adds nothing new.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b20-rectangle-69",
   "type": "rectangle",
   "x": 0,
   "y": 1006,
   "width": 533,
   "height": 181,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "#fff4e6",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 546411,
   "version": 1,
   "versionNonce": 7226301,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "b20-text-70",
   "type": "text",
   "x": 18,
   "y": 1024,
   "width": 321,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 554330,
   "version": 1,
   "versionNonce": 7331030,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Too deep counts as nothing",
   "originalText": "Too deep counts as nothing",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b20-text-71",
   "type": "text",
   "x": 18,
   "y": 1062,
   "width": 486,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 562249,
   "version": 1,
   "versionNonce": 7435759,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A TI-LFA repair with more labels than S’s Max SID\ndepth is not installed, so it protects nothing and\nthe pair falls through to \"unprotected\" (A15, D44).",
   "originalText": "A TI-LFA repair with more labels than S’s Max SID\ndepth is not installed, so it protects nothing and\nthe pair falls through to \"unprotected\" (A15, D44).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
