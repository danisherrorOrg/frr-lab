  {
   "id": "b20-text-5",
   "type": "text",
   "x": 18,
   "y": 476,
   "width": 529,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 39595,
   "version": 1,
   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Router colour = the method each destination is credited to:\nteal ECMP, green LFA, orange Remote LFA. The diagonal P1–P4\ncosts 20 from P1 and 40 back.",
   "originalText": "Router colour = the method each destination is credited to:\nteal ECMP, green LFA, orange Remote LFA. The diagonal P1–P4\ncosts 20 from P1 and 40 back.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
