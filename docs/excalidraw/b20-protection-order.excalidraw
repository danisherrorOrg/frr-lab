   "versionNonce": 8378320,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Many pairs are protected by more than one method. LFA Lab credits each one once, to the simplest that works: ECMP, then LFA, then Remote LFA, then TI-LFA. From PE1 in\nExample 4: 2 ECMP, 1 LFA, 3 Remote LFA, though every row also has a TI-LFA repair.",
   "originalText": "Many pairs are protected by more than one method. LFA Lab credits each one once, to the simplest that works: ECMP, then LFA, then Remote LFA, then TI-LFA. From PE1 in\nExample 4: 2 ECMP, 1 LFA, 3 Remote LFA, though every row also has a TI-LFA repair.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
