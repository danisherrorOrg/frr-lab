   "text": "Example 4: the ISP core, PE1 protects link\nPE1–P1",
   "originalText": "Example 4: the ISP core, PE1 protects link\nPE1–P1",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
