   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red dashed: the protected link PE1–P1 (S = PE1, E = P1, c =\n10).",
   "originalText": "Red dashed: the protected link PE1–P1 (S = PE1, E = P1, c =\n10).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-6",
   "type": "text",
   "x": 18,
   "y": 653,
   "width": 538,
   "height": 40,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green: P(PE1) = {P2, P4}. PE1’s shortest paths to them start\nwith PE1–P2.",
   "originalText": "Green: P(PE1) = {P2, P4}. PE1’s shortest paths to them start\nwith PE1–P2.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-7",
   "type": "text",
   "x": 18,
   "y": 703,
   "width": 529,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Gray: P3 and PE2 tie. PE1’s shortest path to each goes over\nPE1–P1, so they are out.",
   "originalText": "Gray: P3 and PE2 tie. PE1’s shortest path to each goes over\nPE1–P1, so they are out.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-8",
   "type": "text",
   "x": 18,
   "y": 753,
   "width": 377,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 63352,
   "version": 1,
   "versionNonce": 837832,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Diagonal P1–P4: 20 from P1 to P4, 40 back.",
   "originalText": "Diagonal P1–P4: 20 from P1 to P4, 40 back.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
