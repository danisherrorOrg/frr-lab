   "versionNonce": 1780393,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example        Link   P(S)     Out on a tie\n-------------  -----  -------  ------------------------------------\n2  ring        S–E    {A, B}   C: 2 = 1 + 1\n3  ring, B–C   S–E    {A, B}   C: 2 = 1 + 1\n8              S–E    {N}      B: 3 = 2 + 1,  C: 6 = 2 + 4,  D: 4 = 2 + 2",
   "originalText": "Example        Link   P(S)     Out on a tie\n-------------  -----  -------  ------------------------------------\n2  ring        S–E    {A, B}   C: 2 = 1 + 1\n3  ring, B–C   S–E    {A, B}   C: 2 = 1 + 1\n8              S–E    {N}      B: 3 = 2 + 1,  C: 6 = 2 + 4,  D: 4 = 2 + 2",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
