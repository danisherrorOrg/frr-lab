  {
   "id": "b08-text-55",
   "type": "text",
   "x": 18,
   "y": 829,
   "width": 382,
   "height": 28,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
