   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One P-space per link, not per D",
   "originalText": "One P-space per link, not per D",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-56",
   "type": "text",
   "x": 18,
   "y": 867,
   "width": 486,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The test never mentions D. S works out P-space once\nfor each protected link and uses it for every\ndestination behind E (RFC 7490 §5.2.1.3).",
   "originalText": "The test never mentions D. S works out P-space once\nfor each protected link and uses it for every\ndestination behind E (RFC 7490 §5.2.1.3).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-57",
   "type": "text",
   "x": 18,
   "y": 941,
   "width": 466,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In Example 4, PE1 → P1 and PE1 → P3 both lose PE1–P1\nand share P(PE1) = {P2, P4}.",
   "originalText": "In Example 4, PE1 → P1 and PE1 → P3 both lose PE1–P1\nand share P(PE1) = {P2, P4}.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-rectangle-58",
   "type": "rectangle",
   "x": 553,
   "y": 811,
   "width": 533,
   "height": 202,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "#fff5f5",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 459302,
   "version": 1,
   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "b08-text-59",
   "type": "text",
   "x": 571,
   "y": 829,
   "width": 395,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Plain P-space is often too small",
   "originalText": "Plain P-space is often too small",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-60",
   "type": "text",
   "x": 571,
   "y": 867,
   "width": 467,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 475140,
   "version": 1,
   "versionNonce": 6283740,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Q(P1) = {P3, PE2} (B10). Plain P ∩ Q = {P2, P4} ∩\n{P3, PE2} = {}: no PQ node.",
   "originalText": "Q(P1) = {P3, PE2} (B10). Plain P ∩ Q = {P2, P4} ∩\n{P3, PE2} = {}: no PQ node.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-61",
   "type": "text",
   "x": 571,
   "y": 920,
   "width": 486,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 483059,
   "version": 1,
   "versionNonce": 6388469,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Extended P-space (B9) adds PE2 through neighbor P2,\nand Remote LFA works. Example 8 is the same: P(S) =\n{N}, and N is not in Q.",
   "originalText": "Extended P-space (B9) adds PE2 through neighbor P2,\nand Remote LFA works. Example 8 is the same: P(S) =\n{N}, and N is not in Q.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-rectangle-62",
   "type": "rectangle",
   "x": 1107,
   "y": 811,
   "width": 533,
   "height": 202,
   "angle": 0,
   "strokeColor": "#495057",
