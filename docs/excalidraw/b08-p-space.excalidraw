   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Edge cases",
   "originalText": "Edge cases",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-text-64",
   "type": "text",
   "x": 1125,
   "y": 867,
   "width": 496,
   "height": 128,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 506816,
   "version": 1,
   "versionNonce": 6702656,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  S and E are never listed: S can’t pass the test,\n   E is always a tie (D17).\n•  Forward distances from S (forward SPF, A1).\n   Metrics can differ per direction.\n•  Parallel links (A10): c(S,E) is the metric of the\n   protected link, not the bundle.",
   "originalText": "•  S and E are never listed: S can’t pass the test,\n   E is always a tie (D17).\n•  Forward distances from S (forward SPF, A1).\n   Metrics can differ per direction.\n•  Parallel links (A10): c(S,E) is the metric of the\n   protected link, not the bundle.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b08-rectangle-65",
   "type": "rectangle",
   "x": 0,
   "y": 1033,
   "width": 1640,
   "height": 117,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
