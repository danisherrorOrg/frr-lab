   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Leaf-spine, every link 10. L1 reaches L2 over SP1 and over\nSP2, both 20: two primary next hops.",
   "originalText": "Leaf-spine, every link 10. L1 reaches L2 over SP1 and over\nSP2, both 20: two primary next hops.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
