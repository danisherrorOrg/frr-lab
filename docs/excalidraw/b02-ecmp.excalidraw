   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "When it fails",
   "originalText": "When it fails",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b02-text-46",
   "type": "text",
   "x": 571,
   "y": 800,
   "width": 496,
   "height": 107,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  Only one primary next hop (L1 → SP1).\n•  The other next hop is on the same LAN: it goes\n   down with S’s interface (A21).\n•  The other next hop’s path crosses S→E (B1 gives a\n   tie or worse).",
   "originalText": "•  Only one primary next hop (L1 → SP1).\n•  The other next hop is on the same LAN: it goes\n   down with S’s interface (A21).\n•  The other next hop’s path crosses S→E (B1 gives a\n   tie or worse).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
