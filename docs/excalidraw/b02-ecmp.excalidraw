  {
   "id": "b02-text-43",
   "type": "text",
   "x": 18,
   "y": 800,
   "width": 496,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 340517,
   "version": 1,
   "versionNonce": 4503347,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "RFC 5286 §3.4: other primary next hops count as LFA\ncandidates too. For L1 → L2 over L1–SP1, SP2 is also\nthe best LFA. The table still says ECMP, the simpler\nof the two (B20).",
   "originalText": "RFC 5286 §3.4: other primary next hops count as LFA\ncandidates too. For L1 → L2 over L1–SP1, SP2 is also\nthe best LFA. The table still says ECMP, the simpler\nof the two (B20).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
