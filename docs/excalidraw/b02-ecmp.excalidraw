   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If S already has two equal-cost next hops for D and one of them doesn’t use the failed link, the traffic keeps flowing over that one with nothing to compute or install.\nThat is the simplest protection there is, so it is credited first.",
   "originalText": "If S already has two equal-cost next hops for D and one of them doesn’t use the failed link, the traffic keeps flowing over that one with nothing to compute or install.\nThat is the simplest protection there is, so it is credited first.",
