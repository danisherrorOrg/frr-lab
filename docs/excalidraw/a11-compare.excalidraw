   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ex. 1, S→D:  LFA used: N, S-N-D, 25\n             TI-LFA S-N-D, 25, same\nEx. 2, S→E:  no LFA\n             RLFA used: PQ B, 4, same\n             TI-LFA 16004 16002, same\nEx. 3, S→E:  no LFA, no PQ node\n             TI-LFA used: 13,\n             16004 24005 16002, same",
   "originalText": "Ex. 1, S→D:  LFA used: N, S-N-D, 25\n             TI-LFA S-N-D, 25, same\nEx. 2, S→E:  no LFA\n             RLFA used: PQ B, 4, same\n             TI-LFA 16004 16002, same\nEx. 3, S→E:  no LFA, no PQ node\n             TI-LFA used: 13,\n             16004 24005 16002, same",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
