   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TI-LFA with link protection is always \"same\" (RFC 9855\n§3).",
   "originalText": "TI-LFA with link protection is always \"same\" (RFC 9855\n§3).",
