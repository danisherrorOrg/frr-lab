   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why Example 4 is the best lesson",
   "originalText": "Why Example 4 is the best lesson",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a11-text-15",
   "type": "text",
   "x": 638,
   "y": 564,
   "width": 962,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 118785,
   "version": 1,
   "versionNonce": 1570935,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Remote LFA’s only PQ node is PE2, so traffic takes the long way (50), then moves again to the 40 path\nafter reconvergence. TI-LFA uses the 40 path at once. A Prefix-SID for P1 sent to P2 would come back:\nP2’s old path to P1 is P2 → PE1 → P1 (20 < 30), over the failed link. So TI-LFA forces P2 → P1 with\nP2’s Adj-SID 24000, then P1’s label 16001.",
   "originalText": "Remote LFA’s only PQ node is PE2, so traffic takes the long way (50), then moves again to the 40 path\nafter reconvergence. TI-LFA uses the 40 path at once. A Prefix-SID for P1 sent to P2 would come back:\nP2’s old path to P1 is P2 → PE1 → P1 (20 < 30), over the failed link. So TI-LFA forces P2 → P1 with\nP2’s Adj-SID 24000, then P1’s label 16001.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
