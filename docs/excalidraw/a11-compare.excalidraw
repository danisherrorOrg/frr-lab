   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a11-text-61",
   "type": "text",
   "x": 1125,
   "y": 860,
   "width": 477,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 483059,
   "version": 1,
   "versionNonce": 6388469,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A router runs Remote LFA only when there is no LFA\n(B13). The compare view still works out the tunnel\nfrom the same P- and Q-spaces, marked \"not run\nhere\", because seeing both is the point.",
   "originalText": "A router runs Remote LFA only when there is no LFA\n(B13). The compare view still works out the tunnel\nfrom the same P- and Q-spaces, marked \"not run\nhere\", because seeing both is the point.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a11-text-62",
   "type": "text",
   "x": 1125,
   "y": 955,
   "width": 225,
   "height": 38,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
