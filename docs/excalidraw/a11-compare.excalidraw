  {
   "id": "a11-text-65",
   "type": "text",
   "x": 18,
   "y": 1110,
   "width": 974,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
