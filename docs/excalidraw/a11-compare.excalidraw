   "roundness": null,
   "seed": 490978,
   "version": 1,
   "versionNonce": 6493198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ex. 1: PQ = N, S-N-D, 25,\n       16003 16004",
   "originalText": "Ex. 1: PQ = N, S-N-D, 25,\n       16003 16004",
   "fontSize": 15,
   "fontFamily": 3,
