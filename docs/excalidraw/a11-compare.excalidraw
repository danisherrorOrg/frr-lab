   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a11-text-55",
   "type": "text",
   "x": 571,
   "y": 860,
   "width": 496,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435545,
   "version": 1,
   "versionNonce": 5760095,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S–E 1, E–D 1, S–N 5, N–D 1, S–M 1, M–N 1. For S → D,\nM and N are both node-protecting LFAs.",
   "originalText": "S–E 1, E–D 1, S–N 5, N–D 1, S–M 1, M–N 1. For S → D,\nM and N are both node-protecting LFAs.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a11-text-56",
   "type": "text",
   "x": 571,
   "y": 913,
   "width": 486,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 443464,
   "version": 1,
   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "N is downstream (1 < 2), M is not (2 < 2 fails), so\nN wins (B7):",
   "originalText": "N is downstream (1 < 2), M is not (2 < 2 fails), so\nN wins (B7):",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a11-text-57",
   "type": "text",
   "x": 571,
   "y": 966,
   "width": 270,
   "height": 38,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "LFA     S-N-D     6\nfinal   S-M-N-D   3   → longer",
   "originalText": "LFA     S-N-D     6\nfinal   S-M-N-D   3   → longer",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
