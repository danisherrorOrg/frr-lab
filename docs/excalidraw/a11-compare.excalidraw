  {
   "id": "a11-text-63",
   "type": "text",
   "x": 1125,
   "y": 1003,
   "width": 332,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
