   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "link: S → A, A hits A–B,\n      A repairs again → loops\nsrlg: S → C → D (6), delivered,\n      repaired by S alone",
   "originalText": "link: S → A, A hits A–B,\n      A repairs again → loops\nsrlg: S → C → D (6), delivered,\n      repaired by S alone",
