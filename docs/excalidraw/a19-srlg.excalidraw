   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Coverage from S",
   "originalText": "Coverage from S",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a19-text-57",
   "type": "text",
   "x": 1125,
   "y": 820,
   "width": 448,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Coverage adds srlg: pairs whose link has shared\nlinks, and how many backups avoid them all.",
   "originalText": "Coverage adds srlg: pairs whose link has shared\nlinks, and how many backups avoid them all.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a19-text-58",
   "type": "text",
   "x": 1125,
   "y": 873,
   "width": 405,
   "height": 57,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 459302,
   "version": 1,
   "versionNonce": 6074282,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SRLG pairs                 2  (D, E over S–E)\nSRLG-safe LFA or RLFA      1  (D: LFA C)\nSRLG-safe TI-LFA           2",
   "originalText": "SRLG pairs                 2  (D, E over S–E)\nSRLG-safe LFA or RLFA      1  (D: LFA C)\nSRLG-safe TI-LFA           2",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a19-text-59",
   "type": "text",
   "x": 1125,
   "y": 940,
   "width": 493,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "E’s PQ node B is reached over S-A-B, through the duct.\nA link with no SRLG: SRLG protection = link protection.",
   "originalText": "E’s PQ node B is reached over S-A-B, through the duct.\nA link with no SRLG: SRLG protection = link protection.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a19-rectangle-60",
