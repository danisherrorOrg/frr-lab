   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "protection: link   LFA A   TI-LFA S-A-B-D  [Prefix B, Prefix D] = 16004 16006\nprotection: srlg   LFA C   TI-LFA S-C-D    [Prefix D]           = 16006",
   "originalText": "protection: link   LFA A   TI-LFA S-A-B-D  [Prefix B, Prefix D] = 16004 16006\nprotection: srlg   LFA C   TI-LFA S-C-D    [Prefix D]           = 16006",
   "fontSize": 15,
