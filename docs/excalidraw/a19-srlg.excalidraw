   "link": null,
   "locked": false
  },
  {
   "id": "a19-text-61",
   "type": "text",
   "x": 18,
   "y": 1081,
   "width": 99,
   "height": 28,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 483059,
   "version": 1,
   "versionNonce": 6388469,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a19-text-62",
   "type": "text",
   "x": 18,
   "y": 1119,
   "width": 1533,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 490978,
   "version": 1,
   "versionNonce": 6493198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Links in the same SRLG fail together, so a backup for one of them must avoid all of them. With protection: srlg, TI-LFA removes the whole group and LFA prefers a\nneighbor whose path stays out of it. In Example 9 that moves the repair from S-A-B-D, which runs into the duct, to S-C-D.",
   "originalText": "Links in the same SRLG fail together, so a backup for one of them must avoid all of them. With protection: srlg, TI-LFA removes the whole group and LFA prefers a\nneighbor whose path stays out of it. In Example 9 that moves the repair from S-A-B-D, which runs into the duct, to S-C-D.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
