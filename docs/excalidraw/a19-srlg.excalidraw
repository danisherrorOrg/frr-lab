   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Fallback, one step at a time",
   "originalText": "Fallback, one step at a time",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a19-text-51",
   "type": "text",
   "x": 571,
   "y": 820,
   "width": 270,
   "height": 57,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
