   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "All metrics 1, except S–C and C–D = 3. S–E and A–B run in\nduct-1: one backhoe cuts both.",
   "originalText": "All metrics 1, except S–C and C–D = 3. S–E and A–B run in\nduct-1: one backhoe cuts both.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
