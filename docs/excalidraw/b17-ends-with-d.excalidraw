  {
   "id": "b17-text-60",
   "type": "text",
   "x": 18,
   "y": 1094,
   "width": 1571,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
