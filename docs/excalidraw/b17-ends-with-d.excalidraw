   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "After the clean-up (B16) only PrefixSID(D) is left:\nthe packet keeps its own label 16004 and is just\nsent out to N. Nothing extra is pushed: the same as\nthe LFA.",
   "originalText": "After the clean-up (B16) only PrefixSID(D) is left:\nthe packet keeps its own label 16004 and is just\nsent out to N. Nothing extra is pushed: the same as\nthe LFA.",
