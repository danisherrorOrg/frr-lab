   "versionNonce": 5341179,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "On SRv6 (A25) the same repair is 2 SIDs and fits.",
   "originalText": "On SRv6 (A25) the same repair is 2 SIDs and fits.",
