   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S must push the whole stack, D’s label included.\nExample 3, S → E is 16004, 24005, 16002: 3 labels.\nWith msd: 2 the repair is \"too deep\" and counts as\nunprotected.",
   "originalText": "S must push the whole stack, D’s label included.\nExample 3, S → E is 16004, 24005, 16002: 3 labels.\nWith msd: 2 the repair is \"too deep\" and counts as\nunprotected.",
