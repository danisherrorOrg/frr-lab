   "roundness": null,
   "seed": 475140,
   "version": 1,
   "versionNonce": 6283740,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The repair list goes on top of the label the packet already carries, so the list always ends with PrefixSID(D). If the walk ends with an Adj-SID into D, D’s label is\nadded after it. Only the labels above it count as extra: Example 3, S → C has 3 labels, 2 of them extra.",
   "originalText": "The repair list goes on top of the label the packet already carries, so the list always ends with PrefixSID(D). If the walk ends with an Adj-SID into D, D’s label is\nadded after it. Only the labels above it count as extra: Example 3, S → C has 3 labels, 2 of them extra.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
