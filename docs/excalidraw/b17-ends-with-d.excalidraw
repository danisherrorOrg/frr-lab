   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55433,
   "version": 1,
   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Purple: the walk ends on an Adj-SID, so C’s own Prefix-SID is\nadded under it.",
   "originalText": "Purple: the walk ends on an Adj-SID, so C’s own Prefix-SID is\nadded under it.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
