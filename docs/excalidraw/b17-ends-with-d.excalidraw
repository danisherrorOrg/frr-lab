   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green: the post-convergence path S → A → B → C (12). The walk\ngives PrefixSID(B), then AdjSID(B→C) to force the costly link.",
   "originalText": "Green: the post-convergence path S → A → B → C (12). The walk\ngives PrefixSID(B), then AdjSID(B→C) to force the costly link.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "b17-text-7",
   "type": "text",
   "x": 18,
   "y": 738,
   "width": 547,
   "height": 40,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
