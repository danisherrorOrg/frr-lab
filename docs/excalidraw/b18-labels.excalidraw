   "versionNonce": 5864824,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  One SRGB on every router:\n   per-router SRGBs are not modelled\n   (D9).\n•  Stacks are shown before\n   penultimate-hop popping (A7).\n•  SRv6 uses SIDs, not labels (A25).",
   "originalText": "•  One SRGB on every router:\n   per-router SRGBs are not modelled\n   (D9).\n•  Stacks are shown before\n   penultimate-hop popping (A7).\n•  SRv6 uses SIDs, not labels (A25).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
