  },
  {
   "id": "b18-text-59",
   "type": "text",
   "x": 18,
   "y": 1075,
   "width": 1590,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 467221,
   "version": 1,
   "versionNonce": 6179011,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A Prefix-SID label is the same on every router: 16000 + the router’s SID index, so B is 16004 everywhere. An Adj-SID is a router’s own name for one of its links: taken\nfrom the file, or numbered from 24000 in neighbor-ID order. That is why Example 3’s repair reads 16004, 24005, 16002.",
   "originalText": "A Prefix-SID label is the same on every router: 16000 + the router’s SID index, so B is 16004 everywhere. An Adj-SID is a router’s own name for one of its links: taken\nfrom the file, or numbered from 24000 in neighbor-ID order. That is why Example 3’s repair reads 16004, 24005, 16002.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
