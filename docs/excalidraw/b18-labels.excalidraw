   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Engine run on a copy of Example 3\nwith B→C set to 24000 in the file:\nB’s auto label for B→A moves from\n24000 to 24001, so B never has two\nlinks on one label (D18).",
   "originalText": "Engine run on a copy of Example 3\nwith B→C set to 24000 in the file:\nB’s auto label for B→A moves from\n24000 to 24001, so B never has two\nlinks on one label (D18).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
