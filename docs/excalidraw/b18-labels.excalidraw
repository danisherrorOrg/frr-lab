   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example 7, router S: S–A 24000, S–E\n24001, S–E#2 24002. Each link of a\nbundle is its own adjacency, so an\nAdj-SID segment names its link (D29).",
   "originalText": "Example 7, router S: S–A 24000, S–E\n24001, S–E#2 24002. Each link of a\nbundle is its own adjacency, so an\nAdj-SID segment names its link (D29).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
