  },
  {
   "id": "a10-text-57",
   "type": "text",
   "x": 18,
   "y": 1136,
   "width": 1533,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 451383,
   "version": 1,
   "versionNonce": 5969553,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A bundle is protected link by link. The other link to the same router is a cheap, always loop-free LFA, but it can never protect against that router failing. Not\nmodelled: an Adj-SID for the whole bundle, LAG members under one adjacency, hashing over equal links.",
   "originalText": "A bundle is protected link by link. The other link to the same router is a cheap, always loop-free LFA, but it can never protect against that router failing. Not\nmodelled: an Adj-SID for the whole bundle, LAG members under one adjacency, hashing over equal links.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
