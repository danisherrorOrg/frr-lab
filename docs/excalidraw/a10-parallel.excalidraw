   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "fail S-E, LFA only:\n  E  S→E over S-E#2   20\n  D  S→A→D            25\nsource E, fail E-D:   ECMP E-D#2\nfail E-D#2 only:      not affected\nfail both:            dropped at E\n  then converge E→S→A→D",
   "originalText": "fail S-E, LFA only:\n  E  S→E over S-E#2   20\n  D  S→A→D            25\nsource E, fail E-D:   ECMP E-D#2\nfail E-D#2 only:      not affected\nfail both:            dropped at E\n  then converge E→S→A→D",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a10-text-54",
   "type": "text",
   "x": 1125,
   "y": 963,
   "width": 484,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
