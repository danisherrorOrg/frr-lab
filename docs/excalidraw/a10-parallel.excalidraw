   "versionNonce": 1570935,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S → D, protect S-E: node protection still wins",
   "originalText": "S → D, protect S-E: node protection still wins",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a10-text-16",
   "type": "text",
   "x": 638,
   "y": 409,
   "width": 768,
   "height": 40,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 126704,
   "version": 1,
   "versionNonce": 1675664,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A over S-A      10 < 15 + 20 ✓   10 < 20 ✓      10 < 20 + 10 ✓   cost 25  ← best\nE over S-E#2    loop-free ✓      downstream ✓   never ✗          cost 30",
   "originalText": "A over S-A      10 < 15 + 20 ✓   10 < 20 ✓      10 < 20 + 10 ✓   cost 25  ← best\nE over S-E#2    loop-free ✓      downstream ✓   never ✗          cost 30",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a10-text-17",
   "type": "text",
   "x": 638,
   "y": 459,
   "width": 288,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
