   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TI-LFA keeps the other link",
   "originalText": "TI-LFA keeps the other link",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a10-text-18",
   "type": "text",
   "x": 638,
   "y": 493,
   "width": 981,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 142542,
   "version": 1,
   "versionNonce": 1885122,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Only the failed link is removed, so S → E over S-E#2 (20) is the post-convergence path (S-A-D-E costs\n35). The walk forces AdjSID(S→E over S-E#2) = 24002, the clean-up drops it (first hop): [PrefixSID(E)],\nsent out on S-E#2.",
   "originalText": "Only the failed link is removed, so S → E over S-E#2 (20) is the post-convergence path (S-A-D-E costs\n35). The walk forces AdjSID(S→E over S-E#2) = 24002, the clean-up drops it (first hop): [PrefixSID(E)],\nsent out on S-E#2.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
