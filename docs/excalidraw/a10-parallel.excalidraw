   "seed": 427626,
   "version": 1,
   "versionNonce": 5655366,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One flow per destination: with two equal links it uses\nthe lowest id (E-D).",
   "originalText": "One flow per destination: with two equal links it uses\nthe lowest id (E-D).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
