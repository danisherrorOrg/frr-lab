   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "S’s normal path to D is S → E → D (cost 2 + 2 = 4).",
   "originalText": "S’s normal path to D is S → E → D (cost 2 + 2 = 4).",
