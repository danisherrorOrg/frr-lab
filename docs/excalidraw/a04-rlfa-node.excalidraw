   "versionNonce": 733103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Green arrows: the node-protecting repair, tunnel to C out via\nN, then C → D. Cost 2 + 3 + 3 + 3 = 11.",
   "originalText": "Green arrows: the node-protecting repair, tunnel to C out via\nN, then C → D. Cost 2 + 3 + 3 + 3 = 11.",
