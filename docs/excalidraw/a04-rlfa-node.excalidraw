   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "•  LFAs are not changed. To prefer or require\n   node-protecting LFAs, use the LFA policy (A16).",
   "originalText": "•  LFAs are not changed. To prefer or require\n   node-protecting LFAs, use the LFA policy (A16).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a04-text-73",
   "type": "text",
   "x": 1125,
   "y": 969,
   "width": 484,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 578087,
   "version": 1,
   "versionNonce": 7645217,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Not modelled: RFC 8102’s preference for a PQ node that\ncovers more ECMP next hops. LFA Lab protects each\nprimary link on its own.",
   "originalText": "Not modelled: RFC 8102’s preference for a PQ node that\ncovers more ECMP next hops. LFA Lab protects each\nprimary link on its own.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a04-text-74",
   "type": "text",
   "x": 1125,
   "y": 1039,
   "width": 475,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 586006,
   "version": 1,
   "versionNonce": 7749946,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Turn it on with protection: node (Topology settings →\nNode failure).",
   "originalText": "Turn it on with protection: node (Topology settings →\nNode failure).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
