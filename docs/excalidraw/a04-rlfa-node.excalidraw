   "roundness": null,
   "seed": 47514,
   "version": 1,
   "versionNonce": 628374,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Red dashed: router E fails, with all its links. Link-mode PQ\nnode B reaches D over B → E → D, so it breaks.",
   "originalText": "Red dashed: router E fails, with all its links. Link-mode PQ\nnode B reaches D over B → E → D, so it breaks.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a04-text-7",
   "type": "text",
   "x": 18,
   "y": 676,
   "width": 547,
   "height": 40,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
