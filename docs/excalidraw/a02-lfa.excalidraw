   "updated": 1,
   "link": null,
   "locked": false,
   "text": "dist(N,D) = 10   dist(N,S) = 15   dist(S,D) = 20   dist(E,D) = 10\ndist(N,E) = 20   (N → D → E = 10 + 10 beats N → S → E = 15 + 10)",
   "originalText": "dist(N,D) = 10   dist(N,S) = 15   dist(S,D) = 20   dist(E,D) = 10\ndist(N,E) = 20   (N → D → E = 10 + 10 beats N → S → E = 15 + 10)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
