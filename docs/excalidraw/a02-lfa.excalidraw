  {
   "id": "a02-text-42",
   "type": "text",
   "x": 18,
   "y": 831,
   "width": 456,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 332598,
   "version": 1,
   "versionNonce": 4398618,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Where LFA fails: the ring (Example 2)",
   "originalText": "Where LFA fails: the ring (Example 2)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-43",
   "type": "text",
   "x": 18,
   "y": 1149,
   "width": 467,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 340517,
   "version": 1,
   "versionNonce": 4503347,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ring, every metric 1. Destination E, protect S–E.\nS’s only other neighbor is A.",
   "originalText": "Ring, every metric 1. Destination E, protect S–E.\nS’s only other neighbor is A.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-44",
   "type": "text",
   "x": 18,
   "y": 1202,
   "width": 365,
   "height": 40,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 348436,
   "version": 1,
   "versionNonce": 4608076,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "dist(A,E) < dist(A,S) + dist(S,E)\n    2     <    1     +    1     = 2  ✗",
   "originalText": "dist(A,E) < dist(A,S) + dist(S,E)\n    2     <    1     +    1     = 2  ✗",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-45",
   "type": "text",
   "x": 18,
   "y": 1252,
   "width": 496,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 356355,
   "version": 1,
   "versionNonce": 4712805,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A tie is not \"less\". A’s shortest path to E is A → S\n→ E (red arrow): S sends to A, A sends it straight\nback. No LFA.",
   "originalText": "A tie is not \"less\". A’s shortest path to E is A → S\n→ E (red arrow): S sends to A, A sends it straight\nback. No LFA.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-46",
   "type": "text",
   "x": 18,
   "y": 1326,
   "width": 484,
   "height": 60,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 364274,
   "version": 1,
   "versionNonce": 4817534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "For destination C, A works: 2 < 1 + 2 = 3 ✓. Over the\nwhole ring LFA protects 50% of pairs. Remote LFA fixes\nthe rest (A3).",
   "originalText": "For destination C, A works: 2 < 1 + 2 = 3 ✓. Over the\nwhole ring LFA protects 50% of pairs. Remote LFA fixes\nthe rest (A3).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
