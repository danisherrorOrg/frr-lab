   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-62",
   "type": "text",
   "x": 1125,
   "y": 1240,
   "width": 486,
   "height": 85,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 490978,
   "version": 1,
   "versionNonce": 6493198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In the ring, S would send E’s traffic to A and A\nwould send it back to S: a loop, so the traffic\nnever arrives. That is why only loop-free neighbors\nare ever used.",
   "originalText": "In the ring, S would send E’s traffic to A and A\nwould send it back to S: a loop, so the traffic\nnever arrives. That is why only loop-free neighbors\nare ever used.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
