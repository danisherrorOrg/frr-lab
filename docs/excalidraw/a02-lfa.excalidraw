   "roundness": null,
   "seed": 142542,
   "version": 1,
   "versionNonce": 1885122,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "N is a node-protecting, downstream LFA: the best kind. S installs N as the backup next hop for D. When\nS–E fails, S just sends to N; N forwards on its normal table. No tunnel, no extra label.",
   "originalText": "N is a node-protecting, downstream LFA: the best kind. S installs N as the backup next hop for D. When\nS–E fails, S just sends to N; N forwards on its normal table. No tunnel, no extra label.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-19",
   "type": "text",
   "x": 638,
   "y": 656,
   "width": 160,
   "height": 24,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
