  {
   "id": "a02-text-107",
   "type": "text",
   "x": 18,
   "y": 1442,
   "width": 309,
   "height": 28,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 847333,
   "version": 1,
   "versionNonce": 11206003,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Neighbors never used (B6)",
   "originalText": "Neighbors never used (B6)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-108",
   "type": "text",
   "x": 18,
   "y": 1480,
   "width": 448,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 855252,
   "version": 1,
   "versionNonce": 11310732,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Skip N if the link S→N or N→S has the IS-IS max\nmetric 16,777,215 (RFC 5286 §3.5).",
   "originalText": "Skip N if the link S→N or N→S has the IS-IS max\nmetric 16,777,215 (RFC 5286 §3.5).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-109",
   "type": "text",
   "x": 18,
   "y": 1533,
   "width": 419,
   "height": 22,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 863171,
   "version": 1,
   "versionNonce": 11415461,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Skip N if it has the overload bit set (A17).",
   "originalText": "Skip N if it has the overload bit set (A17).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-110",
   "type": "text",
   "x": 18,
   "y": 1565,
   "width": 484,
   "height": 40,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 871090,
   "version": 1,
   "versionNonce": 11520190,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Max metric means \"don’t send traffic here\", so it must\nnot carry backups either.",
   "originalText": "Max metric means \"don’t send traffic here\", so it must\nnot carry backups either.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-rectangle-111",
   "type": "rectangle",
   "x": 553,
   "y": 1424,
   "width": 533,
   "height": 199,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "#e3fafc",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 879009,
   "version": 1,
   "versionNonce": 11624919,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "a02-text-112",
   "type": "text",
   "x": 571,
   "y": 1442,
   "width": 321,
   "height": 28,
   "angle": 0,
   "strokeColor": "#0c8599",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 886928,
   "version": 1,
   "versionNonce": 11729648,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ECMP comes first (B2, B20)",
   "originalText": "ECMP comes first (B2, B20)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-113",
   "type": "text",
   "x": 571,
   "y": 1480,
   "width": 486,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 894847,
   "version": 1,
   "versionNonce": 11834377,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If D has a second primary next hop that avoids S–E,\nit already carries traffic: nothing to compute.",
   "originalText": "If D has a second primary next hop that avoids S–E,\nit already carries traffic: nothing to compute.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-114",
   "type": "text",
   "x": 571,
   "y": 1533,
   "width": 467,
   "height": 64,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 902766,
   "version": 1,
   "versionNonce": 11939106,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each pair is credited to the simplest method that\nworks:\nECMP → LFA → Remote LFA → TI-LFA.",
   "originalText": "Each pair is credited to the simplest method that\nworks:\nECMP → LFA → Remote LFA → TI-LFA.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-rectangle-115",
   "type": "rectangle",
   "x": 1107,
   "y": 1424,
   "width": 533,
   "height": 199,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "#f3f0ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 910685,
   "version": 1,
   "versionNonce": 12043835,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "a02-text-116",
   "type": "text",
   "x": 1125,
   "y": 1442,
   "width": 247,
   "height": 28,
   "angle": 0,
   "strokeColor": "#7048e8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 918604,
   "version": 1,
   "versionNonce": 12148564,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Parallel links (A10)",
   "originalText": "Parallel links (A10)",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-117",
   "type": "text",
   "x": 1125,
   "y": 1480,
   "width": 457,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 926523,
   "version": 1,
   "versionNonce": 12253293,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A candidate is a (link, neighbor) pair (RFC 5286\n§3.6). Another link to E itself can be an LFA.",
   "originalText": "A candidate is a (link, neighbor) pair (RFC 5286\n§3.6). Another link to E itself can be an LFA.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-118",
   "type": "text",
   "x": 1125,
   "y": 1533,
   "width": 391,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 934442,
   "version": 1,
   "versionNonce": 12358022,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It is loop-free and downstream, but never\nnode-protecting: it ends at E.",
   "originalText": "It is loop-free and downstream, but never\nnode-protecting: it ends at E.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-rectangle-119",
   "type": "rectangle",
   "x": 0,
   "y": 1643,
   "width": 1640,
   "height": 117,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 942361,
   "version": 1,
   "versionNonce": 12462751,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "a02-text-120",
   "type": "text",
   "x": 18,
   "y": 1661,
   "width": 99,
   "height": 28,
   "angle": 0,
   "strokeColor": "#f08c00",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 950280,
   "version": 1,
   "versionNonce": 12567480,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-121",
   "type": "text",
   "x": 18,
   "y": 1699,
   "width": 1495,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 958199,
   "version": 1,
   "versionNonce": 12672209,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "An LFA is a neighbor whose own shortest path to D doesn’t come back through S: dist(N,D) < dist(N,S) + dist(S,D). It is free (no tunnel, no labels) and works\neverywhere, but on rings and other sparse maps there is often no such neighbor.",
   "originalText": "An LFA is a neighbor whose own shortest path to D doesn’t come back through S: dist(N,D) < dist(N,S) + dist(S,D). It is free (no tunnel, no labels) and works\neverywhere, but on rings and other sparse maps there is often no such neighbor.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a02-text-122",
   "type": "text",
   "x": 0,
   "y": 1774,
   "width": 1165,
   "height": 20,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 966118,
   "version": 1,
