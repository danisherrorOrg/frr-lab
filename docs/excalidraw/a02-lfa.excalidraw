   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Steps in lfa.ts",
   "originalText": "Steps in lfa.ts",
   "fontSize": 19,
   "fontFamily": 2,
