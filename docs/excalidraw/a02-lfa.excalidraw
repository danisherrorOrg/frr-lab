  },
  {
   "id": "a02-text-48",
   "type": "text",
   "x": 571,
   "y": 831,
   "width": 309,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e8590c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
