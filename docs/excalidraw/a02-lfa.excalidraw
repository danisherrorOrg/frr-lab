   "locked": false,
   "text": "How it works: three checks for each other neighbor N",
   "originalText": "How it works: three checks for each other neighbor N",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
