   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TI-LFA for R2 → R4",
   "originalText": "TI-LFA for R2 → R4",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a21-text-52",
   "type": "text",
   "x": 18,
   "y": 800,
   "width": 496,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 411788,
   "version": 1,
   "versionNonce": 5445908,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Post-convergence path with LAN1:R2-R4 and LAN1:R2-R3\nremoved: R2 → R3 → R4 (25).",
   "originalText": "Post-convergence path with LAN1:R2-R4 and LAN1:R2-R3\nremoved: R2 → R3 → R4 (25).",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a21-text-53",
   "type": "text",
   "x": 18,
   "y": 853,
   "width": 336,
   "height": 88,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 419707,
   "version": 1,
   "versionNonce": 5550637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "From R2, R3: 10 over the LAN ≠ path 15 ✗\n  → Adj-SID(R2→R3 over R2-R3)\nFrom R3, R4: 10 < 10+10+0 ✓ → Prefix R4\nAdj-SID dropped: R3 is the first hop\n[PrefixSID(R4)] = 16004, out on R2–R3",
   "originalText": "From R2, R3: 10 over the LAN ≠ path 15 ✗\n  → Adj-SID(R2→R3 over R2-R3)\nFrom R3, R4: 10 < 10+10+0 ✓ → Prefix R4\nAdj-SID dropped: R3 is the first hop\n[PrefixSID(R4)] = 16004, out on R2–R3",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
