   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway",
   "originalText": "Takeaway",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "a21-text-64",
   "type": "text",
   "x": 18,
   "y": 1051,
   "width": 1600,
   "height": 43,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 506816,
   "version": 1,
   "versionNonce": 6702656,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A LAN is one interface with several neighbors behind it. LFA Lab models it as point-to-point links through a pseudonode, but when S protects one LAN neighbor, S’s whole\ninterface counts as failed. So R3 across the same LAN is no backup for R2; R3 over the separate R2–R3 link is.",
   "originalText": "A LAN is one interface with several neighbors behind it. LFA Lab models it as point-to-point links through a pseudonode, but when S protects one LAN neighbor, S’s whole\ninterface counts as failed. So R3 across the same LAN is no backup for R2; R3 over the separate R2–R3 link is.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
