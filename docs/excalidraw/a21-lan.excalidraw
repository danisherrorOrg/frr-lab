  },
  {
   "id": "a21-text-55",
   "type": "text",
   "x": 571,
   "y": 762,
   "width": 210,
   "height": 28,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
